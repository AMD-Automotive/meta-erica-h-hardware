# Sentry FPD power-down/resume machine settings.
#
# These live here, NOT in conf/machine/<machine>.conf, because that file is
# regenerated by the "Import new gen-machine conf output" CI job from the SDT
# tarball and anything not in the gen-machine template is silently wiped.
# MACHINE_FEATURES += "optee" was lost that way once already (commits db5ffee /
# 1d67e0d), which is invisible until the FPD stops power-gating on hardware.
# conf/layer.conf requires this file, so it survives any SDT import.
#
# The `optee' feature is the single switch that (stock meta-xilinx):
#   - builds TF-A with TFA_SPD=opteed (BL32=OP-TEE)  [tf-a 2.14 recipe]
#   - adds the EL-1 OP-TEE partition (tee-raw.bin, load=0x1800000) to the boot
#     image via BIF_OPTEE_ATTR  [machine-xilinx-versal-2ve-2vm.inc]
#   - pulls in u-boot-optee.cfg / linux-optee.cfg
#
# WITHOUT the OP-TEE SPD the APU cluster only RETENTION-suspends on PSCI
# SYSTEM_SUSPEND (isCoreUp==1), so the FPD never power-gates (rail stuck ~1.2 W)
# and the R52 wake fails XPM_ERR_WAKEUP (0x7DB). Companion to the FPD feature in
# ERICA-S (xilpm-ng SUBSYS/DOMAIN_CONTROL_GPIO + the fpd power-down patches +
# board-topology CDO). Drop the append for a machine to A/B a no-OP-TEE image.
#
# :append is used rather than += so it applies regardless of parse order.

MACHINE_FEATURES:append:vek385-xylon-sentry  = " optee"
MACHINE_FEATURES:append:vek385-imx623-sentry = " optee"
