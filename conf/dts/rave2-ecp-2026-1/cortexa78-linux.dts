                                                remote-endpoint = <&visp_isp4_port43_sp>;
                                        };
                                };
                        };
                };

                visp_ss_25: visp_ss@b0004800 {
                        phandle = <0x12>;
                        xlnx,iba4_ppc = <0x4>;
                        compatible = "xlnx,visp-ss-limo-1.0";
                        interrupts = <0x0 0x56 0x4 0x0 0x57 0x4>;
                        xlnx,iba4_max-height = <0x870>;
                        xlnx,io_mode = "limo";
                        xlnx,iba4_vcid = <0x0>;
                        interrupt-parent = <&gic>;
                        xlnx,num_streams = <0x1>;
                        xlnx,ip-name = "visp_ss";
                        reg = <0x0 0xb0004800 0x0 0x800>;
                        xlnx,netfps = <0x3c>;
                        xlnx,iba4_data_format = <0x10>;
                        xlnx,iba4_max-width = <0xf00>;
                        isp_id = <0x5>;
                        xlnx,iba4_frame_rate = <0x3c>;
                        status = "okay";
                        xlnx,rpu = <0x8>;
                        interrupt-names = "tile2_isp1_fusa_irq", "tile2_isp1_isp_irq";
                        xlnx,mem_inputs = <0x0>;

                        ports25: ports {
                                phandle = <0x362>;
                                #address-cells = <0x1>;
                                #size-cells = <0x0>;

                                visp_ss_250vcap_visp_ss_0: port@0 {
                                        phandle = <0x363>;
                                        reg = <0x0>;
                                };

                                port51: port@1 {
                                        phandle = <0x364>;
                                        reg = <0x1>;

                                        visp_isp5_port50_mp: endpoint {
                                                phandle = <0x187>;
                                                type = "output";
                                                remote-endpoint = <&visp_video_5_0_0>;
                                        };
                                };

                                port52: port@2 {
                                        phandle = <0x365>;
                                        reg = <0x2>;

                                        visp_isp5_port50_sp: endpoint {
                                                phandle = <0x188>;
                                                type = "output";
                                                remote-endpoint = <&visp_video_5_0_1>;
                                        };
                                };
                        };
                };

                visp_video_5: visp_video_5 {
                        phandle = <0x366>;
                        status = "okay";
                        compatible = "xlnx,visp-video";
                        id = <0x5>;

                        vcap_ports25: ports {
                                phandle = <0x367>;
                                #address-cells = <0x1>;
                                #size-cells = <0x0>;

                                vport51: port@0 {
                                        phandle = <0x368>;
                                        reg = <0x0>;

                                        visp_video_5_0_0: endpoint {
                                                phandle = <0x185>;
                                                remote-endpoint = <&visp_isp5_port50_mp>;
                                        };
                                };

                                vport52: port@1 {
                                        phandle = <0x369>;
                                        reg = <0x1>;

                                        visp_video_5_0_1: endpoint {
                                                phandle = <0x186>;
                                                remote-endpoint = <&visp_isp5_port50_sp>;
                                        };
                                };
                        };
                };

                encoder: ale2xx@e8040000 {
                        phandle = <0x36a>;
                        interrupt-parent = <&axi_intc_0>;
                        interrupts = <0x2 0x6 0x2>;
                        compatible = "al,ale2xx";
                        clock-names = "mcu";
                        al,devicename = "al_e2xx";
                        reg = <0x0 0xe8040000 0x0 0x80000 0x0 0x8000000 0x0 0x8000000>;
                        xlnx,mcu-clk = <0x3b6>;
                        reg-names = "regs", "apb";
                };

                decoder: ald3xx@e8080000 {
                        phandle = <0x36b>;
                        interrupt-parent = <&axi_intc_0>;
                        interrupts = <0x7 0x2 0x8>;
                        compatible = "al,ald3xx";
                        clock-names = "mcu";
                        al,devicename = "al_d3xx";
                        reg = <0x0 0xe8080000 0x0 0x80000 0x0 0x0 0x0 0x8000000>;
                        xlnx,mcu-clk = <0x396>;
                        reg-names = "regs", "apb";
                };
        };

