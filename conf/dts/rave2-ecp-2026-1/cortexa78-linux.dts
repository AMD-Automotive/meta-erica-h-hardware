                vport412 = "/amba_pl/visp_video_4/ports/port@5";
                visp_video_4_2_1 = "/amba_pl/visp_video_4/ports/port@5/endpoint";
                vport416 = "/amba_pl/visp_video_4/ports/port@6";
                visp_video_4_3_0 = "/amba_pl/visp_video_4/ports/port@6/endpoint";
                vport417 = "/amba_pl/visp_video_4/ports/port@7";
                visp_video_4_3_1 = "/amba_pl/visp_video_4/ports/port@7/endpoint";
                visp_ss_25 = "/amba_pl/visp_ss@b0004800";
                ports25 = "/amba_pl/visp_ss@b0004800/ports";
                visp_ss_250vcap_visp_ss_0 = "/amba_pl/visp_ss@b0004800/ports/port@0";
