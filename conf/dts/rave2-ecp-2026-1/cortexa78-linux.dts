                vcap_ports25 = "/amba_pl/visp_video_5/ports";
                vport51 = "/amba_pl/visp_video_5/ports/port@0";
                visp_video_5_0_0 = "/amba_pl/visp_video_5/ports/port@0/endpoint";
                vport52 = "/amba_pl/visp_video_5/ports/port@1";
                visp_video_5_0_1 = "/amba_pl/visp_video_5/ports/port@1/endpoint";
                encoder = "/amba_pl/ale2xx@e8040000";
                decoder = "/amba_pl/ald3xx@e8080000";
                mmi_tsu_ext_clk = "/mmi_tsu_ext_clk";
                tsu_ext_clk = "/tsu_ext_clk";
                NoC_C0_C1_ddr_memory = "/memory@00000000";
