        amba_pl: amba_pl {
                phandle = <0x2ef>;
                ranges;
                compatible = "simple-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                firmware-name = "vpl_gen_fixed_pld.pdi";

                misc_clk_6: misc_clk_6 {
                        phandle = <0x140>;
                        compatible = "fixed-clock";
                        clock-frequency = <0x8f0cba9>;
