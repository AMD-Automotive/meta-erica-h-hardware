        NoC_C0_C1_ddr_memory: memory@00000000 {
                phandle = <0x4>;
                compatible = "xlnx,axi-noc2-1.1";
                xlnx,ip-name = "axi_noc2";
                device_type = "memory";
                reg = <0x0 0x100000 0x0 0x7ff00000>;
                memory_type = "memory";
        };

        ps_wizard_0_ps11_0_ocm_ram_0_memory: memory@BBF00000 {
                phandle = <0x19>;
                compatible = "xlnx,ocm-ram-11.0", "mmio-sram";
                device_type = "memory";
                reg = <0x0 0xbbf00000 0x0 0x80000>;
        };

        ps_wizard_0_ps11_0_ocm_ram_1_memory: memory@BBF80000 {
                phandle = <0x1a>;
                compatible = "xlnx,ocm-ram-11.0", "mmio-sram";
                device_type = "memory";
                reg = <0x0 0xbbf80000 0x0 0x80000>;
        };

        ps_wizard_0_ps11_0_ocm_ram_2_memory: memory@BBE00000 {
                phandle = <0x1b>;
                compatible = "xlnx,ocm-ram-11.0", "mmio-sram";
                device_type = "memory";
                reg = <0x0 0xbbe00000 0x0 0x80000>;
        };

        ps_wizard_0_ps11_0_ocm_ram_3_memory: memory@BBE80000 {
                phandle = <0x1c>;
                compatible = "xlnx,ocm-ram-11.0", "mmio-sram";
                device_type = "memory";
                reg = <0x0 0xbbe80000 0x0 0x80000>;
        };

        chosen {
                stdout-path = "serial1:115200n8";
                bootargs = "earlycon=pl011,mmio32,0xf1930000 console=ttyAMA1,115200";
                zephyr,console = "serial1";
                zephyr,shell-uart = "serial1";
                zephyr,ipc_shm = "/reserved-memory/ipc@9860000";
                zephyr,ipc = "/mbox_ipi_eb3b1000_eb3b0000";
                zephyr,sram = "/reserved-memory/ddrboot@9800100";
        };

        reserved-memory {
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                ranges;

                ddrboot: ddrboot@9800100 {
                        phandle = <0x36f>;
                        label = "ddrboot";
                        no-map;
                        reg = <0x0 0x9800100 0x0 0x5ff00>;
                        device_type = "memory";
                };

                rsctbl: rsctbl@9800000 {
                        phandle = <0x370>;
                        label = "rsctbl";
                        no-map;
                        reg = <0x0 0x9800000 0x0 0x100>;
                };

                libmetal_elf: libmetal_elf@9968000 {
                        phandle = <0x377>;
                        label = "libmetal_elf";
                        no-map;
                        reg = <0x0 0x9968000 0x0 0x1000000>;
                };

                libmetal_desc0: libmetal_desc0@A968000 {
                        phandle = <0x378>;
                        label = "libmetal_desc0";
                        no-map;
                        reg = <0x0 0xa968000 0x0 0x4000>;
                };

                libmetal_desc1: libmetal_desc1@A96c000 {
                        phandle = <0x379>;
                        label = "libmetal_desc1";
                        no-map;
                        reg = <0x0 0xa96c000 0x0 0x4000>;
                };

                libmetal_data: libmetal_data@A970000 {
                        phandle = <0x37a>;
                        label = "libmetal_data";
                        no-map;
                        reg = <0x0 0xa970000 0x0 0x40000>;
                };

                ipc@9860000 {
                        reg = <0x0 0x9860000 0x0 0x48000>;
                        compatible = "mmio-sram";
                };
        };

        mbox-consumer {
                compatible = "vnd,mbox-consumer";
                mboxes = <&ipi_1_nobuf_to_ipi_2_nobuf 0x0>,
                 <&ipi_1_nobuf_to_ipi_2_nobuf 0x1>;
                mbox-names = "tx", "rx";
        };

        mbox_ipi_eb3b1000_eb3b0000 {
                compatible = "zephyr,mbox-ipm";
                mbox-names = "tx", "rx";
                status = "okay";
                mboxes = <&ipi_1_nobuf_to_ipi_2_nobuf 0x0>,
                 <&ipi_1_nobuf_to_ipi_2_nobuf 0x1>;
        };

        adma_ref_clk: adma_ref_clk {
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x1ad27480>;
        };

        can1_ref_clock: can1_ref_clock {
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x98961be>;
        };

        can3_ref_clock: can3_ref_clock {
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x98961be>;
        };

        i2c0_ref_clock: i2c0_ref_clock {
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x98961be>;
        };

        i2c1_ref_clock: i2c1_ref_clock {
