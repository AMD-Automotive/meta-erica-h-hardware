                misc_clk_2: misc_clk_2 {
                        phandle = <0x13c>;
                        compatible = "fixed-clock";
                        clock-frequency = <0xee6a8bc>;
                        #clock-cells = <0x0>;
                };

                misc_clk_4: misc_clk_4 {
                        phandle = <0x13e>;
                        compatible = "fixed-clock";
                        clock-frequency = <0x8d9ed4e>;
                        #clock-cells = <0x0>;
                };

                misc_clk_0: misc_clk_0 {
                        phandle = <0x139>;
                        compatible = "fixed-clock";
                        clock-frequency = <0x5f5dd19>;
                        #clock-cells = <0x0>;
                };

                auto_iob_ctrl_axi_iic_0: i2c@80000000 {
                        phandle = <0xf2>;
                        interrupts = <0x0 0x5a 0x4 0xa0>;
                        compatible = "xlnx,xps-iic-2.1";
                        interrupt-parent = <&gic_r52>;
                        reg = <0x0 0x80000000 0x0 0x10000>;
