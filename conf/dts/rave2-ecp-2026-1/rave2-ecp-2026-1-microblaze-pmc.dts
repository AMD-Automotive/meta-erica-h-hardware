                interrupt-parent = <&imux>;

                imux: interrupt-multiplex {
                        phandle = <0x1>;
                        compatible = "interrupt-multiplex";
                        #address-cells = <0x0>;
                        #interrupt-cells = <0x3>;
                        interrupt-controller;
                        interrupt-map-mask = <0x0 0xffff 0x0>;
                        interrupt-map = <0x0 0x8c 0x0 0x43 0x0 0x8c &imux>,
                         <0x0 0x8f 0x0 0x43 0x0 0x8f &imux>,
                         <0x0 0x90 0x0 0x43 0x0 0x90 &imux>,
                         <0x0 0x93 0x0 0x43 0x0 0x93 &imux>,
