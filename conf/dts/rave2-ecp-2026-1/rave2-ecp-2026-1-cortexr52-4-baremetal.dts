        domains {

                APU_Linux {
                        phandle = <0x376>;
                        compatible = "openamp,domain-v1";
                        reserved-memory = <0x36c 0x36d 0x36e 0x36f 0x370>;
                        os,type = "linux";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";

                                remoteproc-relation {
                                        compatible = "openamp,remoteproc-v2";

                                        relation0 {
                                                remote = <0x371>;
                                                elfload = <&ddrboot>,
                                                 <&rsctbl>;
                                        };
                                };

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                remote = <0x371>;
                                                carveouts = <0x36c 0x36d 0x36e>;
                                                mbox = <0x26a>;
                                        };
                                };

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                remote = <0x372>;
                                                carveouts = <0x373 0x374 0x375>;
                                                mbox = <0x230>;
                                                timer = <0xc6>;
                                        };
                                };
                        };
                };

                RPU_2_Zephyr {
                        phandle = <0x371>;
                        compatible = "openamp,domain-v1";
                        xlnx,ddr-boot;
                        xlnx,zephyr,mems = "ddrboot@9800100";
                        sram = <0x0 0x9800100 0x0 0x5ff00 0x0 0xeba80000 0x0 0x10000 0x0 0xeba90000 0x0 0x8000 0x0 0xebaa0000 0x0 0x8000>;
                        reserved-memory = <0x36f>;
                        os,type = "zephyr";
                        rpu_pd_val = <0xf8 0x181100c1>;
                        cpu_config_str = "split";
                        core_num = "2";

                        chosen {
                                stdout-path = "serial1:115200n8";
                                bootargs = "earlycon=pl011,mmio32,0xf1930000 console=ttyAMA1,115200";
                                zephyr,console = "serial1";
                                zephyr,shell-uart = "serial1";
                        };

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";
                                cluster_cpu = "cortexr52_2";

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                host = <0x376>;
                                                mbox = <0x25c>;
                                                carveouts = <0x36c 0x36d 0x36e>;
                                        };
                                };
                        };
                };

                RPU_4_BM {
                        phandle = <0x372>;
                        compatible = "openamp,domain-v1";
                        sram = <0x0 0x9968000 0x0 0x1000000 0x0 0xebb00000 0x0 0x10000 0x0 0xebb10000 0x0 0x8000 0x0 0xebb20000 0x0 0x8000>;
                        access = <&can1 0x0>,
                         <&can3 0x0>,
                         <&ipi4 0x0>;
                        cpus = <&cpus_r52_4 0x10 0x80000003>;
                        os,type = "baremetal";
                        rpu_pd_val = <0xf8 0x181100f1>;
                        cpu_config_str = "split";
                        core_num = "4";
                        access-json = "[{\"dev\": \"can@f19f0000\", \"flags\": {}, \"label\": \"canfd_1\"}, {\"dev\": \"can@f1a10000\", \"flags\": {}, \"label\": \"canfd_3\"}, {\"dev\": \"mailbox@eb370000\", \"flags\": {}, \"label\": \"ipi4\"}]";

                        chosen {
                                stdout-path = "serial1:115200n8";
                                bootargs = "earlycon=pl011,mmio32,0xf1930000 console=ttyAMA1,115200";
                        };

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";
                                cluster_cpu = "cortexr52_4";

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                host = <0x376>;
                                                carveouts = <0x373 0x374 0x375>;
                                                mbox = <0x222>;
                                                timer = <0xc5 0xc6>;
                                                elfload = <&libmetal_elf>;
                                        };
                                };
                        };
                };

                PMC_MB {
                        compatible = "openamp,domain-v1";

                        chosen {
                                stdout-path = "serial0:115200n8";
                                bootargs = "earlycon=pl011,mmio32,0xf1920000 console=ttyAMA0,115200";
                        };
                };
        };

        reserved-memory {
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;

                ddrboot: ddrboot@9800100 {
                        phandle = <0x36f>;
                        label = "ddrboot";
                        no-map;
                        reg = <0x0 0x9800100 0x0 0x5ff00>;
                };

                vdev0vring0: vdev0vring0@9860000 {
                        phandle = <0x36c>;
                        label = "vdev0vring0";
                        no-map;
                        reg = <0x0 0x9860000 0x0 0x4000>;
                };

                vdev0vring1: vdev0vring1@9864000 {
                        phandle = <0x36d>;
                        label = "vdev0vring1";
                        no-map;
                        reg = <0x0 0x9864000 0x0 0x4000>;
                };

                vdev0buffer: vdev0buffer@9868000 {
                        phandle = <0x36e>;
                        label = "vdev0buffer";
                        no-map;
                        reg = <0x0 0x9868000 0x0 0x40000>;
                };

                rsctbl: rsctbl@9800000 {
                        phandle = <0x370>;
                        label = "rsctbl";
                        no-map;
                        reg = <0x0 0x9800000 0x0 0x100>;
                };

                libmetal_elf: libmetal_elf@9968000 {
                        phandle = <0x377>;
                        label = "libmetal_elf";
                        no-map;
                        reg = <0x0 0x9968000 0x0 0x1000000>;
                };

                libmetal_desc0: libmetal_desc0@A968000 {
                        phandle = <0x378>;
                        label = "libmetal_desc0";
                        no-map;
                        reg = <0x0 0xa968000 0x0 0x4000>;
                };

                libmetal_desc1: libmetal_desc1@A96c000 {
                        phandle = <0x379>;
                        label = "libmetal_desc1";
                        no-map;
                        reg = <0x0 0xa96c000 0x0 0x4000>;
                };

                libmetal_data: libmetal_data@A970000 {
                        phandle = <0x37a>;
                        label = "libmetal_data";
                        no-map;
                        reg = <0x0 0xa970000 0x0 0x40000>;
                };
        };
};
