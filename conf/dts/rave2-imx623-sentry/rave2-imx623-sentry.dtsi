// DP83867 constants copied from Linux include/dt-bindings/net/ti-dp83867.h
// (GPL-2.0-only OR MIT); MIT selected. GPIO_ACTIVE_LOW copied from
// include/dt-bindings/gpio/gpio.h (GPL-2.0 OR BSD-2-Clause); BSD-2-Clause selected.
#define DP83867_RGMIIDCTL_250_PS        0x0
#define DP83867_RGMIIDCTL_500_PS        0x1
#define DP83867_RGMIIDCTL_750_PS        0x2
#define DP83867_RGMIIDCTL_1_NS          0x3
#define DP83867_RGMIIDCTL_1_25_NS       0x4
#define DP83867_RGMIIDCTL_1_50_NS       0x5
#define DP83867_RGMIIDCTL_1_75_NS       0x6
#define DP83867_RGMIIDCTL_2_00_NS       0x7
#define DP83867_RGMIIDCTL_2_25_NS       0x8
#define DP83867_RGMIIDCTL_2_50_NS       0x9
#define DP83867_RGMIIDCTL_2_75_NS       0xa
#define DP83867_RGMIIDCTL_3_00_NS       0xb
#define DP83867_RGMIIDCTL_3_25_NS       0xc
#define DP83867_RGMIIDCTL_3_50_NS       0xd
#define DP83867_RGMIIDCTL_3_75_NS       0xe
#define DP83867_RGMIIDCTL_4_00_NS       0xf

#define   DP83867_PHYCR_FIFO_DEPTH_4_B_NIB  0x01
#define   GPIO_ACTIVE_LOW 1



/ {
        model = "RAVE2 IMX623 Sentry - AMD Versal Gen 2";
		compatible = "amd,versal2";
		chosen {
			stdout-path = "serial0:115200n8";
			/* irqaffinity keeps GIC SPI 206/207 off Linux: the R52 AIE-manager
			 * firmware registers them as its AIE NPI error/user interrupts
			 * (CONFIG_AIE2PS_NPI_IRQ_ENABLE=y). Verified on HW 2026-08-28:
			 * "AIE2PS GIC NPI IRQs registered: SPI 206 (err), SPI 207 (usr)". */
			/*
			 * CMA SIZING RULE -- the default CMA area is carved out of LOW DDR by the
			 * `cma=` value below (this board cannot use linux,cma-default: the DT pool
			 * must stay at 0x800000000 for ald3xx.fw, and setting both makes
			 * rmem_cma_setup() bypass the DT node -> ZERO CMA).
			 *
			 * So cma= must fit the largest remaining contiguous low-DDR hole.  Add a
			 * big low-DDR no-map carveout and you MUST shrink cma= to match, else:
			 *     cma: Failed to reserve N MiB
			 *     [drm] Failed to initialize the cma mem reserved nodes
			 *     modetest: failed to create dumb buffer: Cannot allocate memory
			 *
			 * rave2-imx623 hit exactly this: aie_remap_shadow@40000000 (256 MB) took
			 * the hole the comment below calls "~0x40000000", leaving 128 MB as the
			 * largest, so cma= dropped 256M -> 96M there.  1920x1080 XR24 dumb buffers
			 * are 8 MB each, so 96 MB is ample.
			 * Check free holes with `lmb_dump_all` (U-Boot `bdinfo`) after any change.
			 */
			bootargs = "earlycon=pl011,mmio32,0xf1920000 console=ttyAMA0,115200 cma=96M iomem=relaxed irqaffinity=0-205,208-255";
			xen_bootargs = "console=dtuart dtuart=serial0 dom0_mem=2500M dom0_max_vcpus=1 bootscrub=0 vwfi=native";
			dom0_bootargs = "console=hvc0 earlycon=xen earlyprintk=xen clk_ignore_unused cma=96M";
		};
		/*
		* Device tree reserved-memory fragment for ERICA-E face motion system.
		*
		* Memory layout (both RAVE2 and VEK385):
		*
		*   0x50000000 - 0x5007FFFF  (512 KB)   R52 firmware code/data
		*   0x50100000 - 0x6FCFFFFF  (508 MB)   Visualization capture circular buffers
		*     CH0: 0x50100000 - 0x57FFFFFF      (127 MB, 96 frames x 1.32 MB NV12)
		*     CH1: 0x58000000 - 0x5FEFFFFF      (127 MB)
		*     CH2: 0x5FF00000 - 0x67DFFFFF      (127 MB)
		*     CH3: 0x67E00000 - 0x6FCFFFFF      (127 MB)
		*   0x70000000 - 0x700FFFFF  (1 MB)     sentry_shared: A78 <-> R52 headers
		*     ISP flag:      0x70000000         (one word; the rest of the 64 KB is free)
		*     Wake rings:    0x70010000         (64 KB, R52 Ethernet wake channel)
		*     Settings:      0x70020000         (sentry_cfg, VCTL, DETQ, reserved: 4 KB each)
		*     free:          0x70024000         (48 KB)
		*     Codec header:  0x70038000         (codec_shared_header_t, "CDEC")
		*     Shared header: 0x70030000         (4 KB, capture_shared_header_t)
		*     YOLO results:  0x70040000         (4 KB, yolo_shared_header_t, A78->R52)
		*   0x70400000 - 0x773FFFFF  (112 MB)   NPU CMA pool (all xdna-driver BOs)
		*   0x77400000 - 0x77FFFFFF  (12 MB)    Ping-pong alternate DMA buffer
		*
		* NOTE: U-Boot scriptaddr is at 0x78000000 (common default).
		* Pingpong region ends at 0x77FFFFFF to avoid overlap.
		* If U-Boot loads images at 0x54000000 (default image_addr), this
		* overlaps the capture region. Update U-Boot env, e.g.:
		*   setenv image_addr 0x18000000
		*   setenv kernel_addr 0x18000000
		*
		* Include this file from the top-level device tree:
		*   /include/ "device_tree_reserved_memory.dtsi"
		*/
		reserved-memory {
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;

			/delete-node/ cma_reserved@800000000;
			// Used to reserve memory for VCU
			/*
			 * 2026-04-28 DEBUG BUILD: shrunk CMA pool to match the
			 * reduced-DDR Vivado config (rave2_reduced_ddr.tcl which
			 * dropped C1/C2/C3 LPDDR5X controllers, leaving only
			 * NoC_C0_C1 with 2GB @ 0x0 + 2GB @ 0x800000000 = 4GB total).
			 *
			 * The original 3GB (0xC0000000) reservation at 0x800000000
			 * extended past the end of physical DRAM (only 2GB now lives
			 * in the high bank), causing cma_init_reserved_areas() to
			 * walk into an unmapped vmemmap region and panic with a
			 * level-2 translation fault on first boot.
			 *
			 * Shrunk to 1GB to fit comfortably inside the 2GB high bank
			 * and leave room for kernel allocations there. Revert to the
			 * original 3GB/0xC0000000 size when the full 4-controller
			 * DDR config is restored.
			 *
			 * ORIGINAL (full-DDR config, restore later):
			 *   reg = <0x8 0x0 0x0 0xC0000000>;   // 3 GB CMA
			 */
			shared_dma_reserved: shared_dma_mem_region {
				compatible = "shared-dma-pool";
				reg = <0x8 0x0 0x0 0x2c000000>;   /* 704 MB CMA (VCU/ALD3); ends at 0x82c000000 where codec_preroll begins */
				//linux,cma-default;
				reusable;
			};

			/*
			 * 2026-04-28 DEBUG BUILD: override the auto-generated
			 * memory@00000000 node to advertise only the DRAM that the
			 * reduced-DDR BD actually provisions. Without this, the
			 * SDT-emitted node still claims 14GB at 0x800000000 (the
			 * old 4-controller layout) and the kernel touches PFNs that
			 * have no backing struct page.
			 *
			 * ORIGINAL auto-generated reg (full-DDR config, restore later):
			 *   reg = <0x0 0x00000000 0x0 0x80000000     // 2 GB low
			 *          0x8 0x00000000 0x3 0x80000000>;   // 14 GB high
			 */

			/*
			* R52 baremetal firmware region.
			* The R52 linker script places code/data starting at 0x50000000.
			* Marked no-map so Linux does not touch this memory.
			*/
			r52_firmware: r52_fw@50000000 {
				reg = <0x0 0x50000000 0x0 0x00080000>;  /* 512 KB */
				no-map;
			};

			/*
			* NoC remap shadow -- this is NOT usable memory.
			*
			* bd.tcl sets CONFIG.REMAPS {M02_AXI {{0x0_4000_0000
			* 0x0200_0000_0000 0x10000000}}} on axi_noc2_0/S08_AXI, which is
			* ps_wizard_0/LPD_AXI_NOC0 -- the NoC port shared by EVERY LPD
			* master, not just the R52s.  So for gem1, USB, ADMA and the R52s,
			* physical 0x40000000..0x4FFFFFFF no longer reaches DDR at all; it
			* is redirected into the AIE array at 0x200_0000_0000.
			*
			* The A78 is NOT affected (the FPD ports S00-S07 carry no remap),
			* so the CPU still sees real DRAM here.  That asymmetry is what
			* makes this dangerous: a DMA buffer the kernel hands to gem1 in
			* this range is written by the CPU into DDR and fetched by the MAC
			* out of the AIE.  The link looks up and passes no traffic.
			*
			* MUST stay in sync with the bd.tcl REMAPS window (base AND size)
			* if the AIE aperture is ever moved or resized.
			*/
			aie_remap_shadow: aie_remap_shadow@40000000 {
				reg = <0x0 0x40000000 0x0 0x10000000>;  /* 256 MB */
				no-map;
			};

			/*
			* NO isp_chain6 carveout on this board -- deliberately.
			*
			* vek385-imx623 has one (isp_chain6@62200000).  Under RPU-master
			* the R52 replays a recorded APU-master bring-up stream, and
			* SETUP_BUFFER_POOL (cmd 33) for chain 6 carries the *Linux CMA*
			* addresses that were live at capture time.  On vek385 those are
			* 0x62200000-0x67137FFF, inside that board's cma=256M arena, so
			* the ISP wrote NV12 frames over DRM framebuffers; reserving the
			* range fixed a rolling display speckle there (confirmed on
			* hardware 2026-09-08).
			*
			* isp_cmds-rave2.bin has the same defect at DIFFERENT addresses:
			*
			*   inst 0  4 x 0x438000  0x40200000-0x41537FFF
			*   inst 1  4 x 0x438000  0x41600000-0x42937FFF
			*   inst 2  4 x 0x438000  0x42A00000-0x43D37FFF
			*   inst 3  4 x 0x438000  0x43E00000-0x45137FFF
			*
			* -- i.e. entirely inside aie_remap_shadow above.  That recording
			* was captured before this board had that carveout, when CMA still
			* sat at 0x40000000.  Reserving the range as an ISP pool would be
			* worse than useless: it would collide with the AIE alias, and
			* replaying the stream verbatim aims 16 NV12 frames' worth of ISP
			* DMA writes into the AIE array.
			*
			* The fix here is to re-record the stream on a board that has
			* aie_remap_shadow (scripts/capture_isp_cmds.sh).  A firmware-side
			* retarget into limo_buf does not fit either: rave2's chain 0 uses
			* 4 buffers per instance (vek385 uses 1), so chain 0 + chain 6 need
			* 35.4 MB and a limo_buf slot is 32 MB.
			*/

			/*
			* Coded pre-roll ring, written by the VCU2 encoder itself.
			* bd.tcl gives vcu2_0/EncData_C0 the DDR_CH0_MED segment
			* (0x800000000 + 2 GB), so the encoder DMAs H.264 straight in here
			* and nothing is copied; the R52 is deliberately excluded from that
			* segment and never touches the bitstream, only the A78 reads it.
			*
			* 4 channels x 160 MB.  The encoder takes one stream buffer per
			* access unit, so the ring is a grid of 256 KB slots: 640 slots
			* per channel ~= 21 s at 30 fps.  A 256 KB slot fits every frame
			* because tRCParam.pMaxPictureSize caps the coded picture --
			* measured max 232 KB over 1208 AUs, against 519 KB uncapped.
			* Ends at 0x854000000, leaving 0x854000000..0x880000000 (704 MB)
			* of the high bank to Linux.
			*
			* WAS 1.3 GB (0x54000000) for the axi4s_video_compress SLW1 ring
			* (4 x CODEC_RING_PER_CH = 336 MB, 268 x 1.25 MB slots, ~8.9 s/ch).
			* H.264 is ~5x denser per second of pre-roll, so it buys 21 s in
			* half the memory.  Reviving SLW1 alongside this needs
			* CODEC_RING_BASE / CODEC_RING_PER_CH in app/R52/src/codec_dma.h
			* re-pointed at a region of its own -- it would overflow this one.
			*/
			/*
			 * Split by the encoder's channel plan (ERICA-E_rpu_vcu_sw vcu2_plan.h); the
			 * node itself is the same for every plan.
			 *   four camera channels only:  4 x 160 MB rings, 256 KB slots
			 *   plans with lower rungs:     +0x00000000  4 x 128 MB camera rings, 256 KB slots
			 *                               +0x20000000  4 x 16 MB lower-rung rings, 64 KB slots
			 *                               +0x24000000  64 MB source slots of the frames the
			 *                                            A78 composes (A78 writes, VCU2 reads)
			 */
			codec_preroll: codec_preroll@82c000000 {
				reg = <0x8 0x2c000000 0x0 0x28000000>;  /* 640 MB @ 0x82c000000: VCU2 coded access units */
				no-map;
			};

			/*
			* ISP LIMO output staging (NV12 1920x1536 per VC, 4 channels).
			* Producer: visp / IspBridge (memcpy or DMABUF).  Consumer: the
			* codec-input axi4s_vid_dma_rd @ b0004..b0007 and the R52
			* (platform.h CAPTURE_BUF_BASE).  4 ch x 0x02000000 (32 MiB):
			*   vc0=0x28000000 vc1=0x2a000000 vc2=0x2c000000 vc3=0x2e000000.
			* Reserved no-map so /dev/mem works under STRICT_DEVMEM and
			* vb2_get_userptr (VM_PFNMAP) succeeds.  Base MIRRORED in ERICA-E
			* (board_config.h, isp_bridge.h, main.cpp, R52 platform.h,
			* configure_{vid_dma_rd,frmbuf}_isp.sh) -- keep in sync.
			*/
			limo_buffers: limo_buf@28000000 {
				reg = <0x0 0x28000000 0x0 0x08000000>;  /* 128 MB */
				no-map;
			};

			/*
			* A78 <-> R52 shared headers.
			*
			* Every occupant is a FIXED ABSOLUTE address compiled into both sides
			* (capture_shared.h, codec_shared.h, yolo_shared.h, power_shared.h), so the
			* base and size of this node must not move.
			*
			*   0x70000000 : ISP master flag word; the rest of the 64 KB is free
			*   0x70010000 : R52 Ethernet wake channel rings and buffers (64 KB)
			*   0x70020000 : sentry_cfg detection settings page   A78 <-> R52
			*   0x70021000 : VCTL encoder runtime control page    A78 <-> R52
			*   0x70022000 : DETQ per-camera detection edges      R52  -> A78
			*   0x70023000 : reserved for a cross-core wake mailbox
			*   0x70024000 : free
			*   0x70030000 : capture_shared_header_t  "CAPT"  R52  -> A78
			*   0x70038000 : codec_shared_header_t    "CDEC"  R52 <-> A78
			*   0x70040000 : yolo_shared_header_t     "YOLO"  R52  -> A78 (seqlock)
			*   0x70048000 : free           (was the NPU ping-pong flag)
			*   0x70050000 : power_shared_header_t    "PWRS"  A78 <-> R52
			*   0x70050800 : PWRX power extension block           A78 <-> R52
			*   0x70070000 : sentry status words
			*   0x70080000 : ISP command staging, scripts/stage_isp_cmds.py (spare tail)
			*
			* Total: 1 MB covers 0x70000000 - 0x700FFFFF.
			*
			* Was named finn_buffer/finn_buf until 2026-08-31.  No sentry BD has a FINN
			* subsystem any more (no post_proc/DMA36/DMA40 cell in any of the four
			* bd.tcl), so the old name described hardware that no longer exists.
			*/
			sentry_shared: sentry_shared@70000000 {
				reg = <0x0 0x70000000 0x0 0x00100000>;  /* 1 MB */
				no-map;
			};

			/*
			* RPU-owned NPU image.  The R52 sentry app stages the pre-built HSA image
			* here (queue, completion words, control code, weights, input tensor and the
			* four classifier output heads) and drives the AIE manager over shmem+IPI.
			* Offsets within the region are fixed -- see ERICA-E app/R52/src/npu_image.h.
			*
			* WAS a `shared-dma-pool` bound to telluride_drm so the amdxdna driver could
			* allocate the model's BOs.  It MUST be no-map now: a reusable pool lets
			* Linux hand out pages the NPU is mid-inference on.  telluride_drm is
			* disabled below for the same reason.
			*
			* All four sentry targets use this base.  The bring-up base 0x28000000 is
			* limo_buf (ISP NV12 staging) on the imx623 BDs, so it cannot be shared.
			*
			* 112 MB against ~61 MB needed by the 4-head YOLOv8n classifier; the top is
			* constrained by U-Boot scriptaddr at 0x78000000.
			*/
			npu_buffers: npu_pool@70400000 {
				reg = <0x0 0x70400000 0x0 0x07000000>;  /* 112 MB, 4MB-aligned for CMA */
				no-map;
			};

			/*
			* Ping-pong double-buffer for DMA/NPU decoupling.
			* erica_vid_dma writes alternate frames here while NPU
			* reads from the primary input BO in npu_pool.
			* Also used as format-17 NCHW scratch when ping-pong
			* is not active (both are never used simultaneously).
			*
			* DDR flag at 0x70048000 (within sentry_shared) tracks
			* which buffer was last written: 0=A ready, 1=B ready.
			*/
			pingpong_buffer: pingpong_buf@77400000 {
				reg = <0x0 0x77400000 0x0 0x00C00000>;  /* 12 MB */
				no-map;
			};
		};

		/*
		 * 2026-04-28 DEBUG BUILD: override the auto-generated
		 * memory@00000000 node to advertise only the DRAM that the
		 * reduced-DDR BD (rave2_reduced_ddr.tcl) actually provisions.
		 *
		 * The reduced BD only assigns DDR_CH0_LEGACY (2GB @ 0x0) and
		 * DDR_CH0_MED (2GB @ 0x800000000) -- total 4GB. The SDT-emitted
		 * node still claims 14GB at 0x800000000 from the old 4-controller
		 * layout; without this override the kernel walks PFNs that have
		 * no backing struct page and panics in cma_init_reserved_areas().
		 *
		 * ORIGINAL auto-generated reg (full-DDR config, restore later):
		 *   reg = <0x0 0x00000000 0x0 0x80000000      // 2 GB low
		 *          0x8 0x00000000 0x3 0x80000000>;    // 14 GB high
		 */
		memory@00000000 {
			device_type = "memory";
			reg = <0x0 0x00000000 0x0 0x80000000>,    /* 2 GB low  */
			      <0x8 0x00000000 0x0 0x80000000>;    /* 2 GB high */
		};
        aliases {
		spi0 = "/axi/spi@f1010000";
		/* U-Boot (board/xilinx/common) reads the board MAC from nvmem* aliases. */
		nvmem0 = &eeprom;
	};
};

&i2c0 {
        /* i2c0 setup matches rave2-ecp.dtsi */
        #address-cells = <1>;
        #size-cells = <0>;
        eeprom: eeprom@50 {
                compatible = "atmel,24c128";
                bootph-all;
                reg = <0x50>;
        };
};

&gpio0 {
        status = "okay";
};

&mmi_dwc3 {
        dr_mode = "host";
        maximum-speed = "super-speed";
        dma-coherent;
        snps,dis_u2_susphy_quirk;
        snps,dis_u3_susphy_quirk;
        snps,usb3_lpm_capable;
};


&gem1 { /* PMC_MIO_48, LPD_MIO0-11/24/25 */
        phy-mode = "rgmii-id";
        /*
         * fixed-link is deliberate and works: the DP83867 straps come up in
         * the correct RGMII mode, autonegotiates on its own, and the MAC does
         * not need to manage it.
         *
         * The old note here said "MDIO doesnt work from ospi" -- that was a
         * misdiagnosis.  MDIO works fine; the PHY simply straps to address
         * 0xa, not 0.  Reading empty address 0 returns 0xffff, which phylib
         * decodes as the very misleading "master-slave cfg: forced master /
         * status: resolution error".  Verified on HW:
         *   phytool read end0/10/2 -> 0x2000 ; end0/10/3 -> 0xa231
         * If this is ever converted to a real phy-handle, use reg = <0xa>.
         */
        fixed-link {
                pause;
                full-duplex;
                speed = <1000>;
        };
};


&ospi { /* PMC_MIO0-10, MIO12 */
        reset-names = "qspi";
        #address-cells = <1>;
        #size-cells = <0>;

	flash0: flash@0 {
		compatible = "micron,mt35xu01gcba1g12", "micron,mt35xu01g", "jedec,spi-nor";
		reg = <0>;
		spi-tx-bus-width = <8>;
		spi-rx-bus-width = <8>;
		spi-max-frequency = <20000000>;
		no-wp;
		spi-nor,octal-dtr-enable;
		boot,primary;
	};
};

&mmi_10gbe {
        status = "disabled";
};

&amba_pl {
	telluride_drm {
		compatible = "xlnx,aiarm";
		status = "disabled";
	};
        // Using a flexible dummy sensor driver for CSI-2 connection
        vid_capture_dummy_src_0: dummy_src_0@0 {
                compatible = "xlnx,dummy_src";
                clock-names = "ap_clk";
                clocks = <&misc_clk_2>;
                xlnx,max-height = <2160>;
                xlnx,max-width = <8192>;
                xlnx,ppc = <4>;
                xlnx,s-axi-ctrl-addr-width = <8>;
                xlnx,s-axi-ctrl-data-width = <32>;
                ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                                reg = <0>;
                                xlnx,video-format = <0>;
                                xlnx,video-width = <8>;
                                dummy_src0_out: endpoint {
                                        /* remote-endpoint = <&csiss0_in>; -- CSI/MIPI disabled: hard ISP owns the sensor */
                                };
                        };
                };
	};
};

// ================================================================
// SENTRY ISP capture pipeline  (matches vek385-imx623-sentry)
//
// The rave2 sentry_imx623 block design
// (hw/tcl/sentry_imx623/rave2/bd.tcl) instantiates the SAME
// ISP + sentry topology as vek385-imx623-sentry:
//
//   vcap/visp_ss_0                    hard ISP (visp_ss_00/01),
//                                     LIMO mode -> writes NV12 to DDR
//   sentry/vid_pre_proces/vcN/        per-VC (4x):
//       axi4s_vid_dma_0               inf  WR DMA  (b0000..b0003)
//       axi4s_vid_dma_1               viz  WR DMA  (b0008..b000b)
//       axi4s_vid_dma_rd              READ-mode broadcaster source
//                                     (b0004..b0007), replaces v_frmbuf_rd
//   sentry/finn_subsystem/            axi4s_vid_dma_rd (FINN feeder,
//                                     b000c) + post_proc_36/40_dma
//
// Differences vs vek385-imx623 that the rave2 SDT reflects:
//   * NO v_frmbuf_rd            -> RD-mode axi4s_vid_dma is the source
//   * NO DT-visible broadcaster -> axis_broadcaster has no AXI-Lite
//                                  ctrl port, so gen-machineconf emits
//                                  no node (nothing to override)
//   * ONE MIPI CSI-2 RX only    -> vcap_hier_mipi_0 (disabled below)
//   * visp_mbox_rpu_6 only       -> single mailbox RPU
// ================================================================

// ----------------------------------------------------------------
// MIPI CSI-2 RX input -- single MIPI, like rave2-ecp.
//
// The hard ISP (visp_ss) drives the IMX623 sensor through its own
// RPU firmware (libsensor over PS I2C0), so the PL-side CSI-2 RX
// subsystem is inert. Disable it so Linux does not bring up an
// unconnected capture subdev (matches rave2-ecp.dtsi). Also drop the
// SDT-generated port@1 -> visp_ss remote-endpoint so the OF-graph
// has no dangling link once we collapse the visp_ss fan-out
// endpoints below.
// ----------------------------------------------------------------
&vcap_hier_mipi_0_mipi_csi2_rx_subsyst_0 {
	status = "disabled";
	ports { port@1 { endpoint { /delete-property/ remote-endpoint; }; }; };
};

// ----------------------------------------------------------------
// WRITE-mode DMAs -- inf (b0000..b0003) + viz (b0008..b000b).
//
// Retag every axi4s_vid_dma with the erica driver compatible (the
// bare xlnx,axi4s-vid-dma-1.0 compat has no kernel driver) and hold
// them disabled at boot. The runtime DT overlay
// (/lib/firmware/erica-vid-dma.dtbo) flips them to "okay" right
// before run_display_sentry.sh launches, then unloads on exit.
// ----------------------------------------------------------------
&sentry_vid_pre_proces_vc0_axi4s_vid_dma_0 {
	compatible = "sentry,erica-vid-dma", "xlnx,axi4s-vid-dma-1.0";
	status = "disabled";
};
&sentry_vid_pre_proces_vc1_axi4s_vid_dma_0 {
	compatible = "sentry,erica-vid-dma", "xlnx,axi4s-vid-dma-1.0";
	status = "disabled";
};
&sentry_vid_pre_proces_vc2_axi4s_vid_dma_0 {
	compatible = "sentry,erica-vid-dma", "xlnx,axi4s-vid-dma-1.0";
	status = "disabled";
};
&sentry_vid_pre_proces_vc3_axi4s_vid_dma_0 {
	compatible = "sentry,erica-vid-dma", "xlnx,axi4s-vid-dma-1.0";
	status = "disabled";
};

// Viz DMAs (b0008..b000b) removed by the codec BD rebuild: the four
// sentry_vid_pre_proces_vcN_axi4s_vid_dma_1 nodes are now the single
// axi4s_video_compress@b0008000 (see cortexa78-linux.dts).  The codec is
// driven by the R52 in polled mode via /dev/mem, so it needs no Linux
// status/IRQ override here.

// ----------------------------------------------------------------
// READ-mode broadcaster-source DMAs (b0004..b0007) + FINN feeder
// (b000c). Configured with sentry,read-source in the shared include
// (staged by device-tree.bbappend SYSTEM_USER_DTSI_EXTRA).
// ----------------------------------------------------------------
/include/ "rave2-imx623-sentry-vid-dma-rd.dtsi"

// ----------------------------------------------------------------
// Hard ISP (visp_ss) + mailbox -- matches vek385-imx623-sentry.
//
// Each visp_ss probe needs a memory-region pointing at its per-RPU
// calibration reserved-memory; visp_mbox_rpu_6 needs the shared
// isp_mbox_buffer. The visp_ss IP was built with 1080p max-height,
// so override iba*_max-height to 0x600 (1536) to accept 1920x1536.
// Collapse the multi-endpoint input ports (port@5 / port@15) that
// the visp async notifier cannot handle.
//
// Tile/ISP -> RPU mapping:  visp_ss_00 -> RPU6 ; visp_ss_01 -> RPU8.
// ----------------------------------------------------------------
// rproc phandle -> the RPU6 core node rpu6_core (r52f@0), NOT the r52fss cluster
// (the xlnx,isp-mbox find_rproc_child resolves via the node backing the rproc
// device, remoteproc1/device -> ebb80000.r52f = r52f@0).
&visp_mbox_rpu_6 { memory-region = <&isp_mbox_buffer>; rproc = <&rpu6_core>; };

&visp_ss_00 {
	memory-region = <&rproc_D_0_6_calib_load>;
	xlnx,name = "visp_ss_00";

	xlnx,iba0_max-width  = <0x780>;    // 1920
	xlnx,iba0_max-height = <0x600>;    // 1536
	xlnx,iba1_max-width  = <0x780>;
	xlnx,iba1_max-height = <0x600>;
	xlnx,iba2_max-width  = <0x780>;
	xlnx,iba2_max-height = <0x600>;
	xlnx,iba3_max-width  = <0x780>;
	xlnx,iba3_max-height = <0x600>;

	ports {
		port@5  { /delete-node/ endpoint@1; };
		port@15 { /delete-node/ endpoint@1; };
	};
};
&visp_ss_01 {
	memory-region = <&rproc_E_0_8_calib_load>;
	xlnx,name = "visp_ss_01";
	xlnx,rpu = <0x8>;
};

// ----------------------------------------------------------------
// AXI INTC -- force ALL inputs to LEVEL trigger (wobble fix,
// matches vek385-imx623-sentry). The SDT emits an edge-triggered
// kind-of-intr that loses DMA edges under NoC back-pressure.
// ----------------------------------------------------------------
&axi_intc_0 {
	xlnx,kind-of-intr = <0x00>;
};

// ----------------------------------------------------------------
// IRQ-input overrides (values from vek385-imx623-sentry, whose
// sentry_vid_pre_proces hierarchy is identical). The 2nd cell is
// forced to 0x4 (level) to match the kind-of-intr override above.
//
// TODO(hw): confirm the ilconcat/axi_intc input wiring in the rave2
// sentry_imx623 bd.tcl matches vek385. If the rave2 BD routes the
// viz/rd cross-bar differently, adjust the swapped values below.
//
//   inf DMAs (b0000..b0003): In2..In5      straight vc0..3
//   viz DMAs (b0008..b000b): In9,10,12,11  vc2/vc3 swapped
//   rd  DMAs (b0004..b0007): In17,20,18,19 vc1/2/3 rotated
//   finn rd  (b000c)        : In21
// ----------------------------------------------------------------
&sentry_vid_pre_proces_vc0_axi4s_vid_dma_0 { interrupts = <0x2 0x4>; };
&sentry_vid_pre_proces_vc1_axi4s_vid_dma_0 { interrupts = <0x3 0x4>; };
&sentry_vid_pre_proces_vc2_axi4s_vid_dma_0 { interrupts = <0x4 0x4>; };
&sentry_vid_pre_proces_vc3_axi4s_vid_dma_0 { interrupts = <0x5 0x4>; };

// Viz DMAs (b0008..b000b) are now the axi4s_video_compress codec node,
// polled by the R52 -- no Linux IRQ override needed.

&sentry_vid_pre_proces_vc0_axi4s_vid_dma_rd { interrupts = <0x11 0x4>; };
&sentry_vid_pre_proces_vc1_axi4s_vid_dma_rd { interrupts = <0x14 0x4>; };
&sentry_vid_pre_proces_vc2_axi4s_vid_dma_rd { interrupts = <0x12 0x4>; };
&sentry_vid_pre_proces_vc3_axi4s_vid_dma_rd { interrupts = <0x13 0x4>; };


// (CSI-2 RX + axis_switch overlays from the old xylon MIPI-capture
//  design removed: the imx623 SDT has no vcap_pipe2 switch/flat-DMA
//  hierarchy -- capture is handled by the sentry ISP overlay above.)




// ================================================================
// VCU2 codec IRQ FIX (validated on HW 2026-08-14: encoder boots + encodes H.264)
//
// interrupt-controller@b00e0000 (AXI INTC) is #interrupt-cells=2 and level-
// triggered (xlnx,irq-is-level=1). The SDT emits a malformed 3-cell
// interrupts=<hwirq 0x2 0x4> for the Allegro encoder/decoder, so al_riscv fails
// to map the IRQ ("type mismatch, failed to map hwirq-8") and probe aborts
// (-ENXIO) BEFORE booting the MCU. The correct 2-cell level-high form is
// <hwirq 0x04> (hwirq 8 = encoder/In8, 7 = decoder/In7 per the BD xlconcat).
// With this fix the encoder core clock (already up from the PDI) is used,
// ale2xx.fw boots ("MCU0: encoder server started"), and ctrlsw_encoder produced
// a valid H.264 stream on hardware. NOTE: the earlier "slab corruption" blamed
// on these blocks was a misdiagnosis -- with the broken IRQ the MCU never
// booted, so it could not DMA. Do NOT re-disable these to chase slab issues.
// ================================================================
// OWNERSHIP: the R52 VCU controller (sentry-vcu-ctrl.elf, remoteproc below)
// drives the Allegro encoder MCU directly through the NSU at 0xE8040000. Only
// one master may own that MCU. While Linux's al_riscv driver was also bound it
// reset and re-loaded the same MCU underneath the R52, and the R52's FW_READY
// handshake was lost -- MCU boot then failed every retry (stage 0xDB601002).
//
// 2026-09-09: these were "okay", with ownership arbitrated at RUNTIME by
// src/app/scripts/vcu_owner.sh instead of here:
//   run_sentry.sh         -> vcu_owner.sh r52    (unbinds al_riscv, R52 owns)
//   run_display_sentry.sh -> vcu_owner.sh linux  (stops R52, rebinds al_riscv)
// They are now "disabled", matching both vek385 sentry machines, so that all
// four sentry machines behave identically from a VCU/NPU perspective.  The R52
// owns the Allegro MCU on every sentry build; leaving the Linux node enabled
// only creates a second master that has to be unbound at runtime.
//
// TRADE-OFF, deliberately accepted: the A78 can no longer bind al_riscv at all,
// so run_display_sentry.sh's 'r' key (display capture through omxh264enc) and
// `vcu_owner.sh linux` stop working on this machine.  Revert this hunk to
// status = "okay" if that A78-side recording path is needed again.
&encoder {
	/* enc = axi_intc_0 In8, dec = In7 (bd.tcl).  The SDT parents these to &gic,
	 * where the line number lands in the 3-cell "type" slot and probe fails. */
	interrupt-parent = <&axi_intc_0>;
	interrupts = <0x8 0x4>;
	memory-region = <&shared_dma_reserved>;
	status = "disabled";
};
// The DECODER is enabled while the encoder above stays disabled. Only the
// encoder MCU is contended: the R52 VCU controller drives it through the NSU
// and one master must own it. The decoder is a separate block -- ald3xx at
// 0xE8080000, compatible "al,ald3xx", its own mcu-clk, no shared reset or
// power-domain -- that the R52 never touches.
//
// It is enabled because the A78 deterrent player decodes H.264 through
// GStreamer omxh264dec, which opens /dev/al_d3xx. That node comes from THIS
// block (al,devicename = "al_d3xx"); the encoder's is "al_e2xx". With the
// decoder disabled omxh264dec fails with "Failed to create context" and the
// player silently falls back to software decode, which is the dominant CPU
// cost of running deterrent mode.
&decoder {
	interrupt-parent = <&axi_intc_0>;
	interrupts = <0x7 0x4>;
	memory-region = <&shared_dma_reserved>;
	status = "okay";
};

// AI Engine aperture: fix power-domains phandle (SDT generates wrong reference)
// and override interrupt mapping
&aie_aperture_0 {
	interrupts = <0x00 0xce 0x04 0x00 0xcf 0x04 0x00 0xd0 0x04>;
};


// ================================================================
// RTC calibration.  The SDT emits no `calibration` on the Linux rtc node, so
// zynqmp-rtc leaves CALIB_WRITE at the ROM default 0x10010 = 17 ticks/second
// -> the seconds counter runs at 32768/17 = 1928 Hz instead of 1 Hz, and every
// R52 alarm delay is meaningless.  0x7fff = 32768 ticks = 1 Hz, matching the
// value already present in the cortexr52-1 baremetal view of the same node.
// ================================================================
&rtc {
       calibration = <0x7fff>;
};

// Sentry drives one SST stream; the driver treats any xlnx,mst-mode-en value, <0> included, as MST enabled, so the property must be absent.
&mmi_dptx {
	/delete-property/ xlnx,mst-mode-en;
};


// NPU MIGRATION / BOOT-CRASH FIX: disable the A78-direct AIE stack.
// The new BD gives the R52 cores AIE access + remaps the AIE NoC aperture, so on
// the A78 the aie aperture is no longer contiguous ("Memory regions are not
// contiguous") and partition 0 is claimed RPU-side ("failed to request partition
// 0: in use"). Both xilinx_aie and amdxdna therefore FAIL to probe, and their
// error/cleanup path corrupts the kernel slab (Oops in __slab_free/__put_partials
// -> kfree_rcu -> RCU stall -> hang). Since AIE is now managed by the R52
// aie-manager firmware (sentry-aie-mgr.elf), the A78 must not bind the AIE at
// all: disable the parent node so neither driver probes. Re-enable only once the
// A78 RPURuntime XRT-over-RPU client replaces amdxdna forever-mode.
&ai_engine_0 {
	status = "disabled";
};


// ================================================================
// IPI wakeup-source — enables suspend-to-RAM wake via R52 doorbell
// Without this, only s2idle (WFI) works, not full S2RAM power-down.
//
// Also add RPU (ipi-id=3) as a mailbox child so the Linux
// zynqmp-ipi-mailbox driver unmasks bit 3 in APU's IPI IMR.
// Without this, RPU doorbell sets APU ISR but the SPI output
// stays low (masked) and GIC Wakeup Controller never fires.
// R52 firmware also unmasks bit 3 directly as belt-and-suspenders.
// ================================================================
&{/zynqmp-ipi} {
	wakeup-source;

	// RPU IPI mailbox — allows R52 doorbell wake from deep suspend
	// Buffer addresses: RPU(ch3)->APU(ch2) request = 0xEB3F0680
	//                   APU(ch2)->RPU(ch3) request = 0xEB3F04C0
	mailbox@eb3f0680 {
		reg = <0x00 0xeb3f04c0 0x00 0x20
		       0x00 0xeb3f04e0 0x00 0x20
		       0x00 0xeb3f0680 0x00 0x20
		       0x00 0xeb3f06a0 0x00 0x20>;
		reg-names = "local_request_region",
			    "local_response_region",
			    "remote_request_region",
			    "remote_response_region";
		#mbox-cells = <0x01>;
		xlnx,ipi-id = <0x03>;
	};
};

// ================================================================
// Remoteproc — R52 baremetal firmware loading via Linux remoteproc
//
// The RAVE2 base cortexa78-linux.dts (from SDT) does NOT include
// a remoteproc node, so we must define the full node here.
//
// Address 0xEBA00000 = R52 core whose ATCM is r52_0a_atcm_global@eba00000
// (SDT cortexr52_1, cpu@1).
// This matches the VEK385 base DTS remoteproc@eba00000 but with
// memory-region pointing to our sentry firmware carveout at 0x50000000.
//
// Power-domain IDs match the Versal Gen 2 silicon (same as VEK385).
// 0xEBA00000 = R52 core 0 (r52_0a; XSDB "Cortex-R52 #0.0") -- the core the
// sentry firmware is linked/loaded to.
//   0x181100bf = R52 core-0 power-domain (owns the r52_0a TCM banks)
//   0x183180cb = PM_DEV_TCM_A_0A (ATCM)
//   0x183180cc = PM_DEV_TCM_A_0B (BTCM)
//   0x183180cd = PM_DEV_TCM_A_0C (CTCM)
// RESOLVED 2026-08-28: an earlier note here claimed "PLM powers but never WAKES
// this core via Linux remoteproc -> fix at BD/PDI". That is NOT true on this
// build. sentry-aie-mgr.elf was loaded on remoteproc0 and ran:
//   remoteproc0: powering up eba00000.r52f
//   remoteproc0: remote processor eba00000.r52f is now up   (state = running)
// No BD/PDI change is needed to load this core.
// (0x181100c0 is the SIBLING core 1 -- do NOT use it.)
//
// Usage from Linux:
//   cp sentry_r52.elf /lib/firmware/
//   echo sentry_r52.elf > /sys/class/remoteproc/remoteproc0/firmware
//   echo start > /sys/class/remoteproc/remoteproc0/state
// ================================================================
/ {
	/* TCM reserved-memory for R52 core 0 (remoteproc driver needs these) */
	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		tcm_r52_0: r52_0_tcm@eba00000 {
			no-map;
			reg = <0x00 0xeba00000 0x00 0x30000>;  /* 192KB: ATCM+BTCM+CTCM */
		};
	};

	remoteproc@eba00000 {
		compatible = "xlnx,versal-net-r52fss";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		xlnx,cluster-mode = <0x00>;
		ranges = <0x00 0x00 0x00 0xeba00000 0x00 0x10000
			  0x00 0x10000 0x00 0xeba10000 0x00 0x8000
			  0x00 0x18000 0x00 0xeba20000 0x00 0x8000>;

		r52f@0 {
			compatible = "xlnx,versal2-r52f";
			power-domains = <&versal2_firmware 0x181100bf>,
					<&versal2_firmware 0x183180cb>,
					<&versal2_firmware 0x183180cc>,
					<&versal2_firmware 0x183180cd>;
			reg = <0x00 0x00 0x00 0x10000
			       0x00 0x10000 0x00 0x8000
			       0x00 0x18000 0x00 0x8000>;
			reg-names = "r52_0a_atcm_global@eba00000",
				    "r52_0a_btcm_global@eba10000",
				    "r52_0a_ctcm_global@eba20000";
			/* Two windows so either image can run on this core:
			 *   aie_mgr_fw   -> sentry-aie-mgr.elf (RPU-managed NPU)
			 *   r52_firmware -> sentry_r52*.elf   (legacy baremetal detection)
			 * The RPU-NPU cutover replaces detection on this core, so the two
			 * are mutually exclusive at runtime.
			 * HW-VERIFIED 2026-08-28 with aie_mgr_fw alone; the second entry is
			 * not yet exercised -- if the loader only honours the first phandle,
			 * swap the order to run the legacy detection firmware. */
			memory-region = <&aie_mgr_fw>, <&r52_firmware>;
		};
	};

	/*
	 * ISP RPU6 remoteproc loader (becomes remoteproc1, after the sentry
	 * R52 at eba00000 = remoteproc0).  init_isp_4cam.sh's
	 *   start_rproc remoteproc1 isp-r52-6-firmware.elf
	 * loads the ISP R52 firmware into rpu6_fw@0x0C000000.  Single-ISP0
	 * design -> only RPU6; RPU7 (r52f@1) and the RPU8/9 cluster
	 * (remoteproc@ebc00000) are intentionally absent.
	 *
	 * The 2026.1 sdt_import no longer flattens system-conf.dtsi, so this
	 * node (like the RPU6 reserved-memory) is not emitted by the base DTS;
	 * define it here.  Structure/addresses mirror the eba00000 node above
	 * and rave2-ecp.dtsi.  Requires rpu6_fw (reserved-memory) + the
	 * isp-r52-6-firmware.elf firmware in the rootfs.
	 */
	remoteproc@ebb80000 {
		compatible = "xlnx,versal-net-r52fss";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		xlnx,cluster-mode = <0x00>;
		ranges = <0x00 0x00 0x00 0xebb80000 0x00 0x10000
			  0x00 0x10000 0x00 0xebb90000 0x00 0x8000
			  0x00 0x18000 0x00 0xebba0000 0x00 0x8000>;

		rpu6_core: r52f@0 {
			compatible = "xlnx,versal2-r52f";
			power-domains = <&versal2_firmware 0x181100f3>,
					<&versal2_firmware 0x18318106>,
					<&versal2_firmware 0x18318107>,
					<&versal2_firmware 0x18318108>;
			reg = <0x00 0x00 0x00 0x10000
			       0x00 0x10000 0x00 0x8000
			       0x00 0x18000 0x00 0x8000>;
			reg-names = "r52_0a_atcm_global@eba00000",
				    "r52_0a_btcm_global@eba10000",
				    "r52_0a_ctcm_global@eba20000";
			memory-region = <&rpu6_fw>;
		};
	};
};

// ================================================================
// NPU MIGRATION — R52_1 VCU (video encoder) controller remoteproc
//
// Second R52 core, loaded by Linux remoteproc with the VCU controller
// Zephyr ELF (sentry-vcu-ctrl.elf).  R52_0 (remoteproc@eba00000 above)
// loads the AIE-manager ELF (replacing sentry_r52.elf) at runtime; this
// R52_1 node drives the hard VCU2 encoder for the pre/post-roll capture.
//
// Firmware is loaded at runtime via sysfs (no firmware-name in DT), exactly
// like remoteproc@eba00000:
//   cp sentry-vcu-ctrl.elf /lib/firmware/
//   echo sentry-vcu-ctrl.elf > /sys/class/remoteproc/remoteprocN/firmware
//   echo start > /sys/class/remoteproc/remoteprocN/state
//
// CORE AND TCMs: this is RPU cluster B core 0 (XSDB "Cortex-R52 #1.0",
// MPIDR 0x100, SMID 0x202).  sentry-vcu-ctrl.elf parks any core whose MPIDR
// is not 0x100.  Xilinx TCM names are r52_<core><cluster>:
//   r52_0a: ATCM eba00000 / BTCM eba10000 / CTCM eba20000  (A0 = remoteproc@eba00000)
//   r52_1a: ATCM eba40000 / BTCM eba50000 / CTCM eba60000  (A1)
//   r52_0b: ATCM eba80000 / BTCM eba90000 / CTCM ebaa0000  (B0 = this node)
//   r52_1b: ATCM ebac0000 / BTCM ebad0000 / CTCM ebae0000  (B1)
// Power-domains (xilpm_ng xpm_nodeid.h):
//   0x181100c1 = PM_DEV_RPU_B_0
//   0x183180d1 = PM_DEV_TCM_B_0A (ATCM)
//   0x183180d2 = PM_DEV_TCM_B_0B (BTCM)
//   0x183180d3 = PM_DEV_TCM_B_0C (CTCM)
// The core and its TCMs must belong to the same RPU: the PLM powers up and
// releases the reset of whichever core owns a requested TCM bank.  Requesting
// another core's TCMs (e.g. TCM_A_1x) brings that core up running from an
// empty TCM; it slides into this firmware at 0x30000 and writes over this
// core's stacks with SMID 0x201.  The firmware does not use its TCMs; the
// driver requires at least one bank per core.
// ================================================================
/ {
	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		/* TCM reserved-memory for R52_1 (r52_0b, RPU B0), so the
		 * remoteproc driver reserves the ATCM+BTCM+CTCM MMIO window. */
		tcm_r52_1: r52_1_tcm@eba80000 {
			no-map;
			reg = <0x00 0xeba80000 0x00 0x30000>;  /* 192KB: ATCM+BTCM+CTCM */
		};

		/* DDR firmware carveout for the R52_1 VCU-controller ELF
		 * (sentry-vcu-ctrl.elf). The Zephyr image is linked at 0x30000
		 * (board ddr_firmware default) with a ~2.9 MB footprint, so the
		 * remoteproc carveout MUST cover 0x30000; reserve 4 MB there.
		 * (The old 512 KB @ 0x50080000 was both too small and the wrong
		 * address, so the ELF could never load.) no-map -> Linux never
		 * touches it. remoteproc@eba80000 references this via &r52_1_firmware. */
		r52_1_firmware: r52_1_fw@30000 {
			reg = <0x0 0x00030000 0x0 0x00400000>;  /* 4 MB */
			no-map;
		};

		/* ===== VCU2 hard-codec (R52_1) working memory =====================
		 * All in low DDR because the 32-bit R52 CPU-copies coded AUs into
		 * the pre-roll ring (vcu2_preroll_put -> memcpy). Two free low-DDR
		 * windows are used, both proven DDR for the R52:
		 *   0x30000000..0x3FFFFFFF  (above limo, below the AIE remap @0x40000000)
		 *   0x60100000..0x6FFFFFFF  (above the 256 MB viz-capture, below sentry_shared)
		 * Keep in sync with app.overlay + vcu2_app_example.c. */
		vcu2_fw: vcu2_fw@30000000 {
			reg = <0x0 0x30000000 0x0 0x02000000>;  /* 32 MB: FW image + H2M/M2H mailbox */
			no-map;
		};
		vcu2_cma: vcu2_cma@32000000 {
			reg = <0x0 0x32000000 0x0 0x06800000>;  /* 104 MB: CtrlSW CMA + bitstream out.
						 * Base/size MUST match VCU2_CMA_PHYS/VCU2_CMA_SIZE in
						 * r52-vcu-ctrl/examples/vcu2_app_example.c.  Starts where
						 * vcu2_fw ends (0x32000000) and ends exactly at
						 * vcu2_preroll_shared (0x38800000). */
			no-map;
		};
		/*
		 * Encoder controller <-> A78 structures (ERICA-E_rpu_vcu_sw include/):
		 *   0x38800000  VPRL pre-roll ring header, up to 8 channels  (vcu2_preroll.h)
		 *   0x38820000  submit ring 1, camera frames                 (vcu2_submit.h)
		 *   0x38830000  SDIR source directory, 8 channels x 7 slots
		 *   0x38840000  submit ring 2, frames the A78 composes
		 *   0x38848000  VCHM encoder channel map                     (vcu2_chmap.h)
		 *   0x3884A000  SGEN source-slot generations
		 *   0x38890000  controller debug words
		 * A controller restart clears 0x38820000..0x3889FFFF.
		 */
		vcu2_preroll_shared: vcu2_preroll_shared@38800000 {
			reg = <0x0 0x38800000 0x0 0x00100000>;  /* 1 MB: A78-visible pre-roll ring header */
			no-map;
		};

		/* Reserve the EXISTING R52 detection viz-capture region so Linux
		 * never allocates into it (CAPTURE_DDR_BASE/_SIZE in the R52
		 * capture_dma.h: 0x50100000, 256 MB, CH0+CH1 @127 MB). Previously
		 * unreserved; making it explicit protects both the detection DMA
		 * and the vcu2_preroll_bytes ring that follows it. */
		viz_capture: viz_capture@50100000 {
			reg = <0x0 0x50100000 0x0 0x10000000>;  /* 256 MB: R52 viz capture (detection) */
			no-map;
		};

		/* Encoded pre-roll BYTE rings (H.264/HEVC AUs). 4 x 32 MB = ~12.8 s
		 * @ 20 Mb/s per channel. R52 writes (CPU memcpy), A78 reads. */
		vcu2_preroll_bytes: vcu2_preroll_bytes@60100000 {
			reg = <0x0 0x60100000 0x0 0x08000000>;  /* 128 MB: 4 x 32 MB pre-roll rings */
			no-map;
		};
	};

	remoteproc@eba80000 {
		compatible = "xlnx,versal-net-r52fss";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		xlnx,cluster-mode = <0x00>;
		ranges = <0x00 0x00 0x00 0xeba80000 0x00 0x10000
			  0x00 0x10000 0x00 0xeba90000 0x00 0x8000
			  0x00 0x18000 0x00 0xebaa0000 0x00 0x8000>;

		r52f@0 {
			compatible = "xlnx,versal2-r52f";
			power-domains = <&versal2_firmware 0x181100c1>,
					<&versal2_firmware 0x183180d1>,
					<&versal2_firmware 0x183180d2>,
					<&versal2_firmware 0x183180d3>;
			reg = <0x00 0x00 0x00 0x10000
			       0x00 0x10000 0x00 0x8000
			       0x00 0x18000 0x00 0x8000>;
			reg-names = "r52_0b_atcm_global@eba80000",
				    "r52_0b_btcm_global@eba90000",
				    "r52_0b_ctcm_global@ebaa0000";
			memory-region = <&r52_1_firmware>, <&r52_firmware>;  /* + the 0x50000000 window: sentry_r52_*.elf links there, sentry-vcu-ctrl.elf at 0x30000 */
		};
	};
};

// ================================================================
// ISP RPU calibration + mailbox reserved-memory
//
// visp_ss_00 / visp_ss_01 / visp_mbox_rpu_6 above reference these
// labels. The 2026.1 sdt_import does not emit them into
// cortexa78-linux.dts, so define them here (no-map; addresses match
// rave2-ecp.dtsi and the vek385 system-conf: rpu6 0xF800000,
// rpu8 0x18854000, isp_mbox 0x1E0A8000 -- all low DDR < 512 MB, so
// no overlap with the sentry carveouts at 0x50000000+).
//
// The full single-RPU6 ISP carveout is now restored below (rpu6
// fw/calib/hal_mem_priv, isp_mbox, rpu_shared, isp_vring, tcm_rpu6),
// addresses verbatim from rave2-ecp.dtsi.  RPU7/8/9 are unused (single
// IMX623 x4 on RPU6); rpu8_calib is the lone RPU8 leftover kept only for
// the &visp_ss_01 override.  All no-map; none overlap CMA or the sentry
// carveouts.
// NOTE(hw): the matching remoteproc@ebb80000 r52f@0 loader (memory-region
// = <&rpu6_fw>) is now defined above (next to remoteproc@eba00000) so
// init_isp_4cam.sh can load isp-r52-6-firmware.elf into RPU6 (remoteproc1),
// as in rave2-ecp.dtsi -- reservations alone only protect DDR.
// ================================================================
/ {
	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		rpu6_fw: rproc6@0c000000 {
			no-map;
			reg = <0x0 0xC000000 0x0 0x3800000>;   /* 56 MB RPU6 ISP firmware */
		};
		rproc_D_0_6_calib_load: rpu6_calib_load {
			no-map;
			reg = <0x0 0xF800000 0x0 0x28000>;      /* 160 KB calibration */
		};
		rproc_D_0_6_hal_mem_priv: rpu6_hal_mem_priv {
			no-map;
			reg = <0x0 0xF828000 0x0 0x1001000>;    /* ~16 MB HAL private */
		};
		/*
		 * rpu8_calib_load: leftover from the AMD 2-ISP reference
		 * (RPU8 = ISP1); UNUSED on this single-ISP0 build.  Kept only
		 * because the &visp_ss_01 override still points its
		 * memory-region here.
		 *
		 * RELOCATED 0x18854000 -> 0x10829000: the old address sat only
		 * ~8.7 MB above the kernel load address 0x18000000, so U-Boot's
		 * lmb (built from this DTB's /reserved-memory, used as U-Boot's
		 * control FDT from OSPI) rejected the kernel Image load with
		 * "Reading file would overwrite reserved memory" and left it with
		 * a bad ARM64 magic.  rave2-xylon-sentry has no RPU8 node there
		 * and boots fine.  RPU8 is unused so this address is arbitrary;
		 * park it contiguously after rpu6_hal_mem_priv (ends 0x10829000),
		 * inside the low ISP carveout, so 0x18000000..0x1E0A8000 (~96 MB)
		 * is clear for the kernel Image.  Drop together with the
		 * visp_ss_01 override to fully retire RPU8.
		 */
		rproc_E_0_8_calib_load: rpu8_calib_load {
			no-map;
			reg = <0x0 0x10829000 0x0 0x28000>;
		};
		isp_mbox_buffer: isp_mbox_buffer@1E0A8000 {
			no-map;
			reg = <0x0 0x1E0A8000 0x0 0x400000>;    /* 4 MB RPU6<->A78 mailbox */
		};
		rpu_shared_mem: rpu_shared_mem@1E4A8000 {
			no-map;
			reg = <0x0 0x1E4A8000 0x0 0x40000>;     /* 256 KB RPU shared */
		};
		isp_vring: vring@1FFF7000 {
			no-map;
			reg = <0x0 0x1FFF7000 0x0 0x8000>;      /* 32 KB RPU6 vring */
		};
		tcm_rpu6: rpu6_tcm {
			no-map;
			reg = <0x0 0xEBB80000 0x0 0x30000>;     /* 192 KB RPU6 TCM */
		};
	};
};

// ================================================================
// NPU MIGRATION: A78-direct amdxdna forever-mode -> RPU-managed AIE
//
// Moves AIE management off the A78 (amdxdna forever-mode) and onto an R52
// running the AIE-manager firmware (ported from the telluride rpu_fw
// reference). The A78 becomes a client that submits NPU jobs to the R52 over
// a shared-memory + IPI transport; the R52 owns the AIE via the NoC NMU remap
// added in bd.tcl (R52 addr 0x40000000 -> AIE phys 0x20_0000_0000).
//
// Transport (default RPU fw build: CONFIG_RPUFW_TRANSPORT_SHMEM=y, no OpenAMP),
// from telluride-rpu-docs tools/apu_aie_test/shmem_transport.h:
//   0xBBE00000  32 KB  APU TX ring   (FW RX)
//   0xBBE08000  32 KB  FW  TX ring   (APU RX)
//   0xBBE10000  32 KB  doorbell
//   IPI: APU (IPI5 @ 0xEB380000) writes BIT(3) to doorbell the R52 AIE-mgr;
//        R52 already added as an IPI child of &{/zynqmp-ipi} above (ipi-id=3).
//
// TODO(sdt): 0xBBE00000 is the reference OCM location -- confirm this OCM range
// is free on the rave2 SDT (our DDR is 0-2G low + 0x800000000 high, so this is
// NOT DDR). If OCM is unavailable, relocate the ring region into a no-map DDR
// carveout and set the matching RPU fw shmem base.
// TODO(migration): repoint remoteproc@eba00000 firmware from sentry_r52.elf to
// the AIE-manager ELF once built (rpu_fw for amd_ve2_rpu). The A78 userspace
// moves from the amdxdna forever-mode driver to the RPURuntime XRT-over-RPU
// client (rpu_ipi_trigger.ko for the privileged IPI trigger).
// ================================================================
/ {
	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		/* A78 <-> R52 AIE-manager shared-memory rings (no-map: the R52 and
		 * the A78 client map it directly; keep Linux allocators out).
		 * 2 clients x 0x18000: apu0_client @0xBBE00000, apu1_client @0xBBE18000
		 * (shmem_clients_cfg[] in the FW's shmem_platform.c). Each client is
		 * 3 x 32 KB: mgmt-rx, mgmt-tx, doorbell. OCM bank 2 is 0xBBE00000. */
		rpu_aie_shmem: rpu_aie_shmem@bbe00000 {
			no-map;
			reg = <0x0 0xBBE00000 0x0 0x30000>;     /* 192 KB (2 clients) */
		};

		/* AIE-manager firmware window for R52_0 (remoteproc@eba00000).
		 *
		 * The stock telluride rpu_fw links at 0x30000, which collides with
		 * r52_1_fw@30000 (sentry-vcu-ctrl.elf on R52_1) since both cores run
		 * concurrently. Our build relinks the image to 0x800000 via
		 * rpu_fw_sentry/sentry.overlay (&ddr_firmware) and keeps the
		 * reference's stock addresses for everything else, so this one window
		 * covers the lot:
		 *   0x430000  256 KB  dram_log_buf
		 *   0x470000  256 B   rsctbl        <- ELF LOAD segment
		 *   0x478000  288 KB  rpmsg_shmem   (unused, CONFIG_OPENAMP=n)
		 *   0x4C0000  3 MB    host_gem_carveout
		 *   0x800000  4 MB    firmware image <- ELF LOAD segments
		 * Free range: r52_1_fw ends at 0x430000, rproc6 starts at 0x0C000000.
		 *
		 * NOTE the FW also logs an "OCM init" block at 0x3ed40000-0x3ed59000.
		 * That is dead code (ocm_init() only LOG_INFs; ocm_get_base/_size have
		 * no callers), so the range is deliberately NOT reserved.
		 */
		aie_mgr_fw: aie_mgr_fw@430000 {
			no-map;
			reg = <0x0 0x00430000 0x0 0x007D0000>;  /* 7.8 MB, ends 0x00C00000 */
		};
	};
};

// ----------------------------------------------------------------
// Reserve TTC4..TTC7 (timer@f1ea0000..f1ed0000) for the R52 ISP firmware.
//
// The isp-r52-N FreeRTOS firmware uses one of these TTCs as its scheduler
// tick (RPU6 -> ttc4 / 0xf1ea0000).  XTtcPs_CfgInitialize() bails with
// XST_DEVICE_IS_STARTED *without* setting IsReady if the TTC counter is
// already running; the subsequent XTtcPs_SetOptions() then trips
// Xil_AssertVoid(IsReady == XIL_COMPONENT_IS_READY) and the R52 spins
// forever in Xil_Assert -- it never gets past "=====TASKS CREATION DONE=====",
// so visp_mbox INIT_FIRMWARE times out (sync failed, -110).
//
// If Linux's cdns,ttc driver binds these nodes it starts their counters,
// causing exactly that.  The AMD reference (vek385-isp) leaves ttc4..ttc7
// disabled in Linux for this reason -- match it so the R52 owns them.
// ----------------------------------------------------------------
&ttc4 { status = "disabled"; };
&ttc5 { status = "disabled"; };
&ttc6 { status = "disabled"; };
&ttc7 { status = "disabled"; };

// ----------------------------------------------------------------
// Disable the LPD ADMA channels -- AIE NoC remap hazard.
//
// The AIE remap in bd.tcl sits on axi_noc2_0/S08_AXI, which is the
// ps_wizard LPD_AXI_NOC0 port -- one NMU shared by EVERY LPD master, not
// just the R52s. ps11_0_lpd_dma_0 (these controllers) is assigned
// DDR_CH0_LEGACY through that same NMU, so any ADMA descriptor pointing
// into the remap window would be silently redirected into the AIE
// aperture instead of DDR.
//
// Nothing consumes them today (the only `dmas =` consumer in the tree is
// the display mmi_dcdma), so this is latent rather than an active bug --
// but the failure mode is silent memory corruption, and the channels are
// free to disable. The A78 is unaffected either way: it egresses via
// FPD_AXI_NOC*, not the LPD NMU.
// ----------------------------------------------------------------
&adma0 { status = "disabled"; };
&adma1 { status = "disabled"; };
&adma2 { status = "disabled"; };
&adma3 { status = "disabled"; };
&adma4 { status = "disabled"; };
&adma5 { status = "disabled"; };
&adma6 { status = "disabled"; };
&adma7 { status = "disabled"; };

// (end of rave2-imx623-sentry.dtsi)
