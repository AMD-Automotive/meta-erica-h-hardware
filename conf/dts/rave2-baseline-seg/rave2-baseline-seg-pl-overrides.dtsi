// TPM module
&spi1 {
    status = "okay";

    tpm@0 {
        compatible = "tcg,tpm_tis-spi","infineon,slb9670";
        reg = <0>;
        mode = <0>;
        spi-max-frequency = <32000000>;

        status = "okay";
    };
};

// TODO - Figure out why SDT is wrong for interrupts
&vcap_pipe3_v_frmbuf_wr_0 {
	interrupts = <0x10 0x2>;
};

&vcap_pipe3_v_frmbuf_wr_1 {
	interrupts = <0x11 0x2>;
};

&vcap_pipe3_v_frmbuf_wr_2 {
	interrupts = <0x12 0x2>;
};

&vcap_pipe3_v_frmbuf_wr_3 {
	interrupts = <0x13 0x2>;
};




