/dts-v1/;
/ {
        compatible = "xlnx,versal2";
        model = "AMD Versal Gen 2";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        interrupt-parent = <&gic_r52>;
        device_id = "xc2ve3558";
        slrcount = <0x1>;
        family = "Versal_2VE_2VM";
        speed_grade = "2MP";
        pruned-sdt = <0x1>;

        options {

                u-boot {
                        compatible = "u-boot,config";
                        bootscr-address = <0x0 0x78000000>;
                };
        };

        cpus_r52_1: cpus-r52@1 {
                phandle = <0x11c>;
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                compatible = "cpus,cluster";
                address-map = <0xf0000000 &amba 0xf0000000 0x10000000>,
                 <0xf9000000 &amba_rpu 0xf9000000 0x3000>,
                 <0x100000 &NoC_C0_C1_ddr_memory 0x100000 0x7ff00000>,
                 <0xedd10000 &mmi_dcdma 0xedd10000 0x1000>,
                 <0xbbf00000 &ps_wizard_0_ps11_0_ocm_ram_0_memory 0xbbf00000 0x80000>,
                 <0xbbf80000 &ps_wizard_0_ps11_0_ocm_ram_1_memory 0xbbf80000 0x80000>,
                 <0xbbe00000 &ps_wizard_0_ps11_0_ocm_ram_2_memory 0xbbe00000 0x80000>,
                 <0xbbe80000 &ps_wizard_0_ps11_0_ocm_ram_3_memory 0xbbe80000 0x80000>,
                 <0xa0000000 &ps_wizard_0_mmi_0_mmi_pcie_region_0 0xa0000000 0x10000000>,
                 <0x80000000 &vcap_pipe2_axi4s_vid_dma_0 0x80000000 0x1000>,
                 <0x80001000 &vcap_pipe2_axi4s_vid_dma_1 0x80001000 0x1000>,
                 <0x80002000 &vcap_pipe2_axi4s_vid_dma_2 0x80002000 0x1000>,
                 <0x80003000 &vcap_pipe2_axi4s_vid_dma_3 0x80003000 0x1000>,
                 <0x80004000 &vcap_pipe2_mipi_csi2_rx_subsyst_0 0x80004000 0x2000>,
                 <0x80008000 &vcap_pipe2_axi4s_vid_dma_4 0x80008000 0x1000>,
                 <0x80009000 &vcap_pipe2_axi4s_vid_dma_5 0x80009000 0x1000>,
                 <0x8000a000 &vcap_pipe2_axi4s_vid_dma_6 0x8000a000 0x1000>,
                 <0x8000b000 &vcap_pipe2_axi4s_vid_dma_7 0x8000b000 0x1000>,
                 <0x80030000 &finn_subsystem_1_post_proc_36_dma_0 0x80030000 0x10000>,
                 <0x80040000 &finn_subsystem_1_post_proc_40_dma_0 0x80040000 0x10000>,
                 <0x80050000 &finn_subsystem_1_axi_gpio_0 0x80050000 0x10000>,
                 <0x80060000 &motion_classifier_subsystem_axi_gpio_0 0x80060000 0x10000>,
                 <0x80070000 &axi_intc_1 0x80070000 0x10000>,
                 <0x80210000 &ryzen_hdio_interfaces_axi_spi_bootrom_ri 0x80210000 0x10000>,
                 <0x80230000 &ryzen_hdio_interfaces_axi_uartlite_1 0x80230000 0x1000>,
                 <0xe8000000 &vcu_vcu2_0 0xe8000000 0x100000>,
                 <0x801a0000 &axi_gpio_rst 0x801a0000 0x10000>,
                 <0x801b0000 &axi_intc_0 0x801b0000 0x10000>,
                 <0x80010000 &ryzen_hdio_interfaces_i2s_receiver_0 0x80010000 0x10000>,
                 <0x80020000 &ryzen_hdio_interfaces_i2s_transmitter_0 0x80020000 0x10000>,
                 <0x80130000 &auto_iob_ctrl_axi_gpio_0 0x80130000 0x10000>,
                 <0x80140000 &auto_iob_ctrl_axi_gpio_1 0x80140000 0x10000>,
                 <0x80150000 &auto_iob_ctrl_axi_gpio_2 0x80150000 0x10000>,
                 <0x80160000 &auto_iob_ctrl_axi_gpio_3 0x80160000 0x10000>,
                 <0x80170000 &auto_iob_ctrl_axi_iic_0 0x80170000 0x10000>,
                 <0x80180000 &auto_iob_ctrl_axi_iic_1 0x80180000 0x10000>,
                 <0x80190000 &auto_iob_ctrl_axi_iic_2 0x80190000 0x10000>,
                 <0x801c0000 &ryzen_hdio_interfaces_axi_gpio_0 0x801c0000 0x10000>,
                 <0x801d0000 &ryzen_hdio_interfaces_axi_gpio_bootrom_ri 0x801d0000 0x10000>,
                 <0x801e0000 &ryzen_hdio_interfaces_axi_gpio_sensorhub_ri 0x801e0000 0x10000>,
                 <0x801f0000 &ryzen_hdio_interfaces_axi_iic_sensorhub_ri 0x801f0000 0x10000>,
                 <0x80200000 &ryzen_hdio_interfaces_axi_quad_spi_ri 0x80200000 0x10000>,
                 <0x80220000 &ryzen_hdio_interfaces_axi_uartlite_0 0x80220000 0x1000>,
                 <0xea460000 &ps_wizard_0_ps11_0_lpd_systmr_read 0xea460000 0x10000>,
                 <0xea470000 &ps_wizard_0_ps11_0_lpd_systmr_ctrl 0xea470000 0x10000>,
                 <0xeaa00000 &ps_wizard_0_ps11_0_ocm_ctrl_3 0xeaa00000 0x10000>,
                 <0xeb400000 &ps_wizard_0_ps11_0_ocm_xmpu_0 0xeb400000 0x10000>,
                 <0xeb410000 &ps_wizard_0_ps11_0_lpd_slcr_0 0xeb410000 0x100000>,
                 <0xeb510000 &ps_wizard_0_ps11_0_lpd_slcr_secure_0 0xeb510000 0x40000>,
                 <0xeb580000 &ps_wizard_0_ps11_0_rpu_a 0xeb580000 0x8000>,
                 <0xeb590000 &ps_wizard_0_ps11_0_rpu_b 0xeb590000 0x8000>,
                 <0xeb5d0000 &ps_wizard_0_ps11_0_ocm_ctrl_0 0xeb5d0000 0x10000>,
                 <0xeb5e0000 &ps_wizard_0_ps11_0_crl_0 0xeb5e0000 0x300000>,
                 <0xeb960000 &ps_wizard_0_ps11_0_ocm_ctrl_1 0xeb960000 0x10000>,
                 <0xeb980000 &ps_wizard_0_ps11_0_ocm_xmpu_1 0xeb980000 0x10000>,
                 <0xeb990000 &ps_wizard_0_ps11_0_lpd_xppu_0 0xeb990000 0x10000>,
                 <0xeb9b0000 &ps_wizard_0_ps11_0_lpd_afi_0 0xeb9b0000 0x10000>,
                 <0xeb9d0000 &ps_wizard_0_ps11_0_ocm_ctrl_2 0xeb9d0000 0x10000>,
                 <0xebd00000 &adma0 0xebd00000 0x10000>,
                 <0xebd10000 &adma1 0xebd10000 0x10000>,
                 <0xebd20000 &adma2 0xebd20000 0x10000>,
                 <0xebd30000 &adma3 0xebd30000 0x10000>,
                 <0xebd40000 &adma4 0xebd40000 0x10000>,
                 <0xebd50000 &adma5 0xebd50000 0x10000>,
                 <0xebd60000 &adma6 0xebd60000 0x10000>,
                 <0xebd70000 &adma7 0xebd70000 0x10000>,
                 <0xebe8c000 &asu_dma0 0xebe8c000 0x1000>,
                 <0xec200000 &ps_wizard_0_ps11_0_crf_0 0xec200000 0x100000>,
                 <0xec810000 &ps_wizard_0_ps11_0_fpd_slv_asild_xmpu_0 0xec810000 0x10000>,
                 <0xec820000 &ps_wizard_0_ps11_0_fpd_slv_asilb_xmpu_0 0xec820000 0x10000>,
                 <0xec880000 &ps_wizard_0_ps11_0_fpd_afi_0 0xec880000 0x10000>,
                 <0xec890000 &ps_wizard_0_ps11_0_fpd_afi_1 0xec890000 0x10000>,
                 <0xec8a0000 &ps_wizard_0_ps11_0_fpd_afi_2 0xec8a0000 0x10000>,
                 <0xec8b0000 &ps_wizard_0_ps11_0_fpd_afi_3 0xec8b0000 0x10000>,
                 <0xec8c0000 &ps_wizard_0_ps11_0_fpd_slcr_0 0xec8c0000 0x10000>,
                 <0xec8e0000 &ps_wizard_0_ps11_0_fpd_slcr_secure_0 0xec8e0000 0x10000>,
                 <0xec910000 &ps_wizard_0_ps11_0_fpd_systmr_read 0xec910000 0x10000>,
                 <0xec920000 &ps_wizard_0_ps11_0_fpd_systmr_ctrl 0xec920000 0x10000>,
                 <0xecc00000 &ps_wizard_0_ps11_0_apu_0 0xecc00000 0x10000>,
                 <0xecd00000 &ps_wizard_0_ps11_0_apu_1 0xecd00000 0x10000>,
                 <0xece00000 &ps_wizard_0_ps11_0_apu_2 0xece00000 0x10000>,
                 <0xecf00000 &ps_wizard_0_ps11_0_apu_3 0xecf00000 0x10000>,
                 <0xed000000 &gpu 0xed000000 0x800000>,
                 <0xed800000 &ps_wizard_0_mmi_0_mmi_pcie0 0xed800000 0x80000>,
                 <0xed900000 &ps_wizard_0_mmi_0_mmi_gtyp_cfg 0xed900000 0x20000>,
                 <0xed920000 &mmi_10gbe 0xed920000 0x10000>,
                 <0xed930000 &ps_wizard_0_mmi_0_mmi_pipe_gem_slcr 0xed930000 0x1000>,
                 <0x0 &ps_wizard_0_mmi_0_mmi_pcie0_slcr 0x0 0xed939000>,
                 <0xeda00000 &ps_wizard_0_mmi_0_mmi_common 0xeda00000 0x300000>,
                 <0xedd00000 &mmi_dc 0xedd00000 0x10000>,
                 <0xedd10000 &ps_wizard_0_mmi_0_mmi_dpdma 0xedd10000 0x10000>,
                 <0xede00000 &mmi_dptx 0xede00000 0x40000>,
                 <0xede40000 &ps_wizard_0_mmi_0_mmi_usb3phy_crpara 0xede40000 0x40000>,
                 <0xede80000 &ps_wizard_0_mmi_0_mmi_trng 0xede80000 0x10000>,
                 <0xede90000 &ps_wizard_0_mmi_0_mmi_udh_pll 0xede90000 0x10000>,
                 <0xedea0000 &ps_wizard_0_mmi_0_mmi_udh_slcr 0xedea0000 0x10000>,
                 <0xedeb0000 &ps_wizard_0_mmi_0_mmi_hdcp 0xedeb0000 0x8000>,
                 <0xedeb8000 &ps_wizard_0_mmi_0_mmi_usb3phy_tca 0xedeb8000 0x4000>,
                 <0xedebc000 &ps_wizard_0_mmi_0_mmi_usb2phy 0xedebc000 0x4000>,
                 <0xf0310000 &pmc_ppu1_mdm_0 0xf0310000 0x8000>,
                 <0xf0800000 &coresight 0xf0800000 0x4000>,
                 <0xf08f0000 &ps_wizard_0_ps11_0_coresight_lpd_atm 0xf08f0000 0xf000>,
                 <0xf0c40000 &ps_wizard_0_ps11_0_coresight_fpd_stm 0xf0c40000 0x4000>,
                 <0xf1010000 &ospi 0xf1010000 0x10000>,
                 <0xf1020000 &gpio1 0xf1020000 0x10000>,
                 <0xf10a0000 &ps_wizard_0_ps11_0_pmc_ufs_0 0xf10a0000 0x10000>,
                 <0xf10b0000 &ufshc 0xf10b0000 0x10000>,
                 <0xf1110000 &ps_wizard_0_ps11_0_pmc_global_0 0xf1110000 0x50000>,
                 <0xf11c0000 &dma0 0xf11c0000 0x10000>,
                 <0xf11d0000 &dma1 0xf11d0000 0x10000>,
                 <0xf11e0000 &ps_wizard_0_ps11_0_pmc_aes 0xf11e0000 0x10000>,
                 <0xf11f0000 &ps_wizard_0_ps11_0_pmc_bbram_ctrl 0xf11f0000 0x10000>,
                 <0xf1200000 &ps_wizard_0_ps11_0_pmc_rsa 0xf1200000 0x10000>,
                 <0xf1210000 &ps_wizard_0_ps11_0_pmc_sha3 0xf1210000 0x10000>,
                 <0xf1220000 &ps_wizard_0_ps11_0_pmc_slave_boot 0xf1220000 0x10000>,
                 <0xf1220000 &ps_wizard_0_mmi_0_pmc_slave_boot 0xf1220000 0x10000>,
                 <0xf1230000 &pmc_trng 0xf1230000 0x10000>,
                 <0xf1240000 &ps_wizard_0_ps11_0_pmc_efuse_ctrl 0xf1240000 0x10000>,
                 <0xf1250000 &ps_wizard_0_ps11_0_pmc_efuse_cache 0xf1250000 0x10000>,
                 <0xf1260000 &ps_wizard_0_ps11_0_crp_0 0xf1260000 0x10000>,
                 <0xf1270000 &sysmon0 0xf1270000 0x30000>,
                 <0xf12a0000 &rtc 0xf12a0000 0x10000>,
                 <0xf12b0000 &pmc_cfu_apb_0 0xf12b0000 0x10000>,
                 <0xf12d0000 &pmc_cfi_cframe_0 0xf12d0000 0x1000>,
                 <0xf12f0000 &ps_wizard_0_ps11_0_pmc_xmpu_0 0xf12f0000 0x10000>,
                 <0xf1300000 &ps_wizard_0_ps11_0_pmc_xppu_npi_0 0xf1300000 0x10000>,
                 <0xf1310000 &ps_wizard_0_ps11_0_pmc_xppu_0 0xf1310000 0x10000>,
                 <0xf1800000 &ps_wizard_0_ps11_0_pmc_sha2 0xf1800000 0x10000>,
                 <0xf1920000 &serial0 0xf1920000 0x10000>,
                 <0xf1930000 &serial1 0xf1930000 0x10000>,
                 <0xf1940000 &i2c0 0xf1940000 0x10000>,
                 <0xf1950000 &i2c1 0xf1950000 0x10000>,
                 <0xf19d0000 &spi1 0xf19d0000 0x10000>,
                 <0xf19f0000 &can1 0xf19f0000 0x10000>,
                 <0xf1a10000 &can3 0xf1a10000 0x10000>,
                 <0xf1a20000 &ps_wizard_0_ps11_0_lpd_iou_slcr_0 0xf1a20000 0x20000>,
                 <0xf1a40000 &ps_wizard_0_ps11_0_lpd_iou_secure_slcr_0 0xf1a40000 0x10000>,
                 <0xf1a50000 &gpio0 0xf1a50000 0x10000>,
                 <0xf1a70000 &gem1 0xf1a70000 0x10000>,
                 <0xf1e60000 &ttc0 0xf1e60000 0x10000>,
                 <0xf1e70000 &ttc1 0xf1e70000 0x10000>,
                 <0xf1e80000 &ttc2 0xf1e80000 0x10000>,
                 <0xf1e90000 &ttc3 0xf1e90000 0x10000>,
                 <0xf1ea0000 &ttc4 0xf1ea0000 0x10000>,
                 <0xf1eb0000 &ttc5 0xf1eb0000 0x10000>,
                 <0xf1ec0000 &ttc6 0xf1ec0000 0x10000>,
                 <0xf1ed0000 &ttc7 0xf1ed0000 0x10000>,
                 <0xf2100000 &ps_wizard_0_ps11_0_pmc_slave_boot_stream 0xf2100000 0x10000>,
                 <0xf2100000 &ps_wizard_0_mmi_0_pmc_slave_boot_stream 0xf2100000 0x10000>,
                 <0xf6000000 &ps_wizard_0_ps11_0_pmc_ram_npi 0xf6000000 0x2000000>,
                 <0xf8000000 &ps_wizard_0_ps11_0_fpd_cmn 0xf8000000 0x4000000>,
                 <0x1000 &vcap_pipe2_mipi_csi2_rx_subsyst_0_phy 0x1000 0x1000>,
                 <0x0 &vcap_pipe2_mipi_csi2_rx_subsyst_0_rx 0x0 0x1000>,
                 <0xe2000000 &gic_r52 0xe2000000 0x10000>,
                 <0x0 &ps_wizard_0_ps11_0_r52_tcm_alias 0x0 0x20000>;
                #ranges-address-cells = <0x1>;
                #ranges-size-cells = <0x1>;

                cortexr52_1: cpu@1 {
                        phandle = <0x11d>;
                        compatible = "arm,cortex-r52";
                        device_type = "cpu";
                        reg = <0x1>;
                        power-domains = <&versal2_firmware 0x181100c0>;
                        xlnx,is-cache-coherent = <0x0>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,ip-name = "cortexr52";
                        cpu-frequency = <0x34274ea8>;
                        bus-handle = <0x2>;
                        xlnx,cpu-clk-freq-hz = <0x34274ea8>;
                };
        };

        aliases {
                serial0 = "/axi/serial@f1920000";
                serial1 = "/axi/serial@f1930000";
                mmc0 = "/axi/mmc@f1040000";
                mmc1 = "/axi/mmc@f1050000";
                i2c0 = "/amba_pl/i2c@b1090000";
                i2c1 = "/amba_pl/i2c@b10a0000";
                i2c2 = "/amba_pl/i2c@b10b0000";
                i2c3 = "/amba_pl/i2c@b1140000";
                i2c4 = "/axi/i2c@f1980000";
                i2c5 = "/axi/i2c@f1990000";
                i2c6 = "/axi/i2c@f19a0000";
                i2c7 = "/axi/i2c@f19b0000";
                i2c8 = "/axi/i2c@f1000000";
                spi0 = "/amba_pl/axi_quad_spi@b1150000";
                spi1 = "/amba_pl/axi_quad_spi@b0160000";
                spi2 = "/axi/spi@f19c0000";
                spi3 = "/axi/spi@f19d0000";
                serial4 = "/axi/coresight@f0800000";
                serial2 = "/amba_pl/serial@b1170000";
                serial3 = "/amba_pl/serial@b0180000";
        };

        firmware {

                psci: psci {
                        phandle = <0x132>;
                        compatible = "arm,psci-1.0";
                        method = "smc";
                };

                versal2_firmware: versal2-firmware {
                        phandle = <0xd5>;
                        compatible = "xlnx,versal2-firmware";
                        bootph-all;
                        method = "smc";
                        #power-domain-cells = <0x1>;

                        versal2_reset: reset-controller {
                                phandle = <0x101>;
                                compatible = "xlnx,versal-reset";
                                #reset-cells = <0x1>;
                        };

                        versal2_clk: clock-controller {
                                phandle = <0xcf>;
                                #clock-cells = <0x1>;
                                compatible = "xlnx,versal2-clk";
                                bootph-all;
                                clocks = <&ref_clk>,
                                 <&ref_clk>;
                                clock-names = "ref", "pl_alt_ref";
                        };

                        versal_net_power: zynqmp-power {
                                phandle = <0x133>;
                                compatible = "xlnx,zynqmp-power";
                                interrupt-parent = <&gic_r52>;
                                interrupts = <0x0 0x39 0x4>;
                                mboxes = <&ipi_mailbox_pmu1 0x0>,
                                 <&ipi_mailbox_pmu1 0x1>;
                                mbox-names = "tx", "rx";
                        };

                        versal_sec_cfg: versal-sec-cfg {
                                phandle = <0x134>;
                                compatible = "xlnx,versal-sec-cfg";
                                #address-cells = <0x1>;
                                #size-cells = <0x1>;

                                bbram_zeroize: bbram-zeroize@4 {
                                        phandle = <0x135>;
                                        reg = <0x4 0x4>;
                                };

                                bbram_key: bbram-key@10 {
                                        phandle = <0x136>;
                                        reg = <0x10 0x20>;
                                };

                                bbram_usr: bbram-usr@30 {
                                        phandle = <0x137>;
                                        reg = <0x30 0x4>;
                                };

                                bbram_lock: bbram-lock@48 {
                                        phandle = <0x138>;
                                        reg = <0x48 0x4>;
                                };

                                user_key0: user-key@110 {
                                        phandle = <0x139>;
                                        reg = <0x110 0x20>;
                                };

                                user_key1: user-key@130 {
                                        phandle = <0x13a>;
                                        reg = <0x130 0x20>;
                                };

                                user_key2: user-key@150 {
                                        phandle = <0x13b>;
                                        reg = <0x150 0x20>;
                                };

                                user_key3: user-key@170 {
                                        phandle = <0x13c>;
                                        reg = <0x170 0x20>;
                                };

                                user_key4: user-key@190 {
                                        phandle = <0x13d>;
                                        reg = <0x190 0x20>;
                                };

                                user_key5: user-key@1b0 {
                                        phandle = <0x13e>;
                                        reg = <0x1b0 0x20>;
                                };

                                user_key6: user-key@1d0 {
                                        phandle = <0x13f>;
                                        reg = <0x1d0 0x20>;
                                };

                                user_key7: user-key@1f0 {
                                        phandle = <0x140>;
                                        reg = <0x1f0 0x20>;
                                };
                        };
                };
        };

        fpga: fpga-region {
                phandle = <0x141>;
                compatible = "fpga-region";
                fpga-mgr = <&versal_fpga>;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
        };

        timer: timer {
                phandle = <0x142>;
                compatible = "arm,armv8-timer";
                interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
        };

        versal_fpga: versal-fpga {
                phandle = <0xf6>;
                compatible = "xlnx,versal-fpga";
        };

        amba_apu: apu-bus {
                phandle = <0x3>;
                compatible = "simple-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                u-boot,dm-pre-reloc;
        };

        amba_rpu: rpu-bus {
                phandle = <0xd0>;
                compatible = "indirect-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                interrupt-parent = <&gic_r52>;
                u-boot,dm-pre-reloc;

                gic_r52: interrupt-controller@e2000000 {
                        phandle = <0xd3>;
                        compatible = "arm,gic-v3", "arm,gic";
                        #interrupt-cells = <0x3>;
                        interrupt-controller;
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x1 0x9 0x4>;
                        #address-cells = <0x2>;
                        #size-cells = <0x2>;
                        reg = <0x0 0xe2000000 0x0 0x10000 0x0 0xe2100000 0x0 0x80000>;
                        status = "okay";
                        xlnx,ip-name = "rcpu_gic";
                        xlnx,name = "ps_wizard_0_ps11_0_rcpu_gic";
                };
        };

        sensor0: versal-thermal-sensor {
                phandle = <0xf7>;
                compatible = "xlnx,versal-thermal";
                #thermal-sensor-cells = <0x1>;
                io-channels = <&sysmon0 0x8>;
                io-channel-names = "sysmon-temp-channel";
        };

        thermal-zones {

                versal_thermal: versal-thermal {
                        phandle = <0x143>;
                        polling-delay-passive = <0xfa>;
                        polling-delay = <0x3e8>;
                        thermal-sensors = <&sensor0 0x0>;

                        trips {

                                temp_alert: temp-alert {
                                        phandle = <0x144>;
                                        temperature = <0x11170>;
                                        hysteresis = <0x0>;
                                        type = "passive";
                                };

                                ot_crit: ot-crit {
                                        phandle = <0x145>;
                                        temperature = <0x1e848>;
                                        hysteresis = <0x0>;
                                        type = "critical";
                                };
                        };

                        cooling-maps {
                        };
                };

                versal_thermal_aie: versal-aie-thermal {
                        phandle = <0x146>;
                        polling-delay-passive = <0xfa>;
                        polling-delay = <0x3e8>;
                        thermal-sensors = <&sensor0 0x1>;

                        trips {

                                temp_alert_aie: temp-alert-aie {
                                        phandle = <0x147>;
                                        temperature = <0x11170>;
                                        hysteresis = <0x0>;
                                        type = "passive";
                                };

                                ot_crit_aie: ot-crit-aie {
                                        phandle = <0x148>;
                                        temperature = <0x1e848>;
