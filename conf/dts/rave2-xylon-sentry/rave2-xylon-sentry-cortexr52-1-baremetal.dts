                gpu: gpu@ed000000 {
                        phandle = <0x7b>;
                        status = "okay";
                        compatible = "arm,mali-ptm";
                        ranges;
                        #address-cells = <0x2>;
                        #size-cells = <0x2>;
                        #interrupt-cells = <0x2>;
                        xlnx,gpu-slices = <0x2>;
