                                #address-cells = <0x1>;
                                #size-cells = <0x0>;

                                axis_switch_port0vcap_pipe3_axis_switch_0: port@0 {
                                        phandle = <0x2be>;
                                        reg = <0x0>;

                                        vcap_pipe3_axis_switch_0vcap_pipe3_mipi_csi2_rx_subsyst_0: endpoint {
                                                phandle = <0x2bf>;
                                        };
                                };
                        };
                };
        };

        mmi_tsu_ext_clk: mmi_tsu_ext_clk {
                phandle = <0x120>;
                compatible = "fixed-clock";
                clock-frequency = <0x17d78400>;
                #clock-cells = <0x0>;
        };

        tsu_ext_clk: tsu_ext_clk {
                phandle = <0x11e>;
                compatible = "fixed-clock";
                clock-frequency = <0x17d78400>;
                #clock-cells = <0x0>;
        };

