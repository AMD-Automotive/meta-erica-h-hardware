                        xlnx,clock-freq = <0x98961be>;
                        xlnx,i2c-clk-freq-hz = <0x98961be>;
                        xlnx,ip-name = "i2c";
                        xlnx,iic-board-interface = "custom";
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;
                        bootph-all;
                        clock-frequency = <0x61a80>;

                        i2c-arbitrator@72 {
                                compatible = "nxp,pca9541";
                                bootph-all;
                                reg = <0x72>;

                                i2c-arb {
                                        #address-cells = <0x1>;
                                        #size-cells = <0x0>;

                                        tca6416_u37: gpio@20 {
                                                phandle = <0x120>;
                                                compatible = "ti,tca6416";
                                                reg = <0x20>;
                                                #gpio-cells = <0x2>;
                                                gpio-controller;
                                        };

                                        eeprom: eeprom@54 {
                                                phandle = <0x16e>;
                                                compatible = "atmel,24c128";
                                                bootph-all;
                                                reg = <0x54>;
                                        };

                                        i2c-mux@77 {
                                                compatible = "nxp,pca9548";
                                                #address-cells = <0x1>;
                                                #size-cells = <0x0>;
                                                reg = <0x77>;
                                                i2c-mux-idle-disconnect;

                                                i2c@0 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x0>;
                                                };

                                                i2c@1 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x1>;
                                                };

                                                i2c@2 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x2>;
                                                };

                                                i2c@3 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x3>;
                                                };

                                                i2c@4 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x4>;

                                                        hub: usb-hub@2d {
                                                                phandle = <0x11c>;
                                                                compatible = "microchip,usb5744";
                                                                reg = <0x2d>;
                                                        };
                                                };
                                        };
                                };
                        };
                };

