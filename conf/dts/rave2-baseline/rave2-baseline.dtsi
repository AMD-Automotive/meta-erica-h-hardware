			switch1_out3: endpoint {
				remote-endpoint = <&vcap1_in3>;
			};
		};
	};

};

// TPM module
&spi1 {
    status = "okay";

    tpm@0 {
        compatible = "tcg,tpm_tis-spi","infineon,slb9670";
        reg = <0>;
        mode = <0>;
        spi-max-frequency = <32000000>;

        status = "okay";
    };
};

// TODO - Figure out why SDT is wrong for interrupts
&vcap_pipe3_v_frmbuf_wr_0 {
	interrupts = <0x10 0x2>;
};

&vcap_pipe3_v_frmbuf_wr_1 {
	interrupts = <0x11 0x2>;
};

&vcap_pipe3_v_frmbuf_wr_2 {
	interrupts = <0x12 0x2>;
};

&vcap_pipe3_v_frmbuf_wr_3 {
	interrupts = <0x13 0x2>;
};




// Set the CSI-2 RX to use YUV422 video format
// This is DPHY 2 on IOB
&vcap_pipe1_mipi_csi2_rx_subsyst_0 {
	xlnx,csi-pxl-format = <0x1e>; //YUV
        status = "okay";
	video-reset-gpios = <&axi_gpio_rst 0x5 0x1>;
        interrupts = <0x3 0x2>;
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			xlnx,video-format = <0>;
			xlnx,video-width = <8>;

			csiss2_in: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&dummy_src2_out>;
			};
		};
		port@1 {
			reg = <1>;

			xlnx,video-format = <0>;
			xlnx,video-width = <8>;

			csiss2_out: endpoint {
				remote-endpoint = <&switch2_in0>;
			};
		};
	};

};

