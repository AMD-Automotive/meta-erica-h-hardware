// TODO - Figure out why SDT is wrong for interrupts
&vcap_pipe1_v_frmbuf_wr_0 {
	interrupts = <0x4 0x2>;
};

&vcap_pipe1_v_frmbuf_wr_1 {
	interrupts = <0x5 0x2>;
};

&vcap_pipe1_v_frmbuf_wr_2 {
