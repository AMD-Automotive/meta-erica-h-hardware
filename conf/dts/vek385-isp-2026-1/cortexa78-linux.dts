        mmi_tsu_ext_clk: mmi_tsu_ext_clk {
                phandle = <0x12f>;
                compatible = "fixed-clock";
                clock-frequency = <0xee6b280>;
                #clock-cells = <0x0>;
        };

        tsu_ext_clk: tsu_ext_clk {
                phandle = <0x12c>;
                compatible = "fixed-clock";
                clock-frequency = <0x17d78400>;
                #clock-cells = <0x0>;
        };

        NoC_C1_C4_ddr_memory: memory@00000000 {
                phandle = <0x5>;
                compatible = "xlnx,axi-noc2-1.1";
                xlnx,ip-name = "axi_noc2";
                device_type = "memory";
                reg = <0x0 0x0 0x0 0x80000000 0x8 0x0 0x1 0x80000000>;
                memory_type = "memory";
        };

        NoC_C0_ddr_memory: memory@50000000000 {
                phandle = <0x4>;
                compatible = "xlnx,axi-noc2-1.1";
                xlnx,ip-name = "axi_noc2";
                device_type = "memory";
                reg = <0x500 0x0 0x0 0x80000000>;
                memory_type = "memory";
        };

        chosen {
                stdout-path = "serial1:115200n8";
                bootargs = "earlycon=pl011,mmio32,0xf1930000 console=ttyAMA1,115200";
        };

        reserved-memory {
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
        };

        pwm-fan {
                compatible = "pwm-fan";
                pwms = <&ttc0 0x2 0x9c40 0x1>;
        };

        usb_hub_delay: enable-delay {
                phandle = <0x134>;
                compatible = "gpio-delay";
                #gpio-cells = <0x3>;
                gpio-controller;
                gpios = <&gpio0 0xe 0x1>;
        };

        vdd_usb_hub: regulator-vdd-usb-hub {
                phandle = <0x135>;
                compatible = "regulator-fixed";
                regulator-name = "vdd_usb_hub";
                regulator-min-microvolt = <0x325aa0>;
                regulator-max-microvolt = <0x325aa0>;
                regulator-always-on;
                regulator-boot-on;
        };

        vdd2_usb_hub: regulator-vdd2-usb-hub {
                phandle = <0x136>;
                compatible = "regulator-fixed";
                regulator-name = "vdd2_usb_hub";
                regulator-min-microvolt = <0x124f80>;
                regulator-max-microvolt = <0x124f80>;
                regulator-always-on;
                regulator-boot-on;
        };

        usb3_dp_phy_ref_clk: usb3-phy-ref-clk {
                phandle = <0x138>;
                bootph-all;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x16e3600>;
        };

