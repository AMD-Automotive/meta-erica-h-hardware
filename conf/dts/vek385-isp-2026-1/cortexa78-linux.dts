                gic: interrupt-controller@e2000000 {
                        phandle = <0x29>;
                        xlnx,ip-name = "acpu_gic";
                        status = "okay";
                        ranges;
                        #size-cells = <0x2>;
                        #address-cells = <0x2>;
                        interrupts = <0x1 0x9 0x4>;
                        interrupt-parent = <&gic>;
                        interrupt-controller;
                        reg = <0x0 0xe2000000 0x0 0x10000 0x0 0xe2060000 0x0 0x200000>;
                        #interrupt-cells = <0x3>;
                        compatible = "arm,gic-v3";

