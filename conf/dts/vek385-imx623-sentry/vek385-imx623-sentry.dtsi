// =====================================================================
// AXI INTC -- force ALL inputs to LEVEL trigger (wobble fix).
//
// The SDT generator emits xlnx,kind-of-intr = <0x18003> for axi_intc_0
// (b01b0000), which programs several DMA inputs as EDGE-triggered.
// Under heavy load (shared NoC back-pressure, ARID collapse, etc.)
// the Allegro/DMA ISRs occasionally lose an edge and the pipeline
// wedges ("wobble").  Forcing level-triggered behavior on every
// input eliminates the lost-edge race.
//
// The Xilinx axi-intc-4.1 driver (irq-xilinx.c) derives each input's
// trigger type from xlnx,kind-of-intr on the controller node, so a
// single override here is sufficient kernel-side.  We also flip the
// 2nd cell of every child `interrupts` property from 0x2 (edge) to
// 0x4 (level) for DT-consistency / lopper sanity.
//
// Side-loaded equivalent: decompiled_dts/<date>/system_wobble_fix.dts
// (see /memories/dts_sideload.md).
// =====================================================================
&axi_intc_0 {
	xlnx,kind-of-intr = <0x00>;
};

// IRQ-input mapping derived from bd.tcl ilconcat_0 wiring (source of truth).
// The auto-generated SDT puts SCRAMBLED hwirq numbers on every video node
// (they collide with VCU encoder/decoder on inputs 7/8), so we override
// every video-DMA + MIPI node here to the ACTUAL ilconcat input it is
// wired to in the BD.  Layout (axi_intc_0 inputs):
//   In2..5   : inf  DMAs vc0..3   (b0000..b0003)  -- v_frmbuf_wr_N
//   In6      : vcu  irq_error
//   In7      : vcu  irq_dec       (encoder/decoder MUST stay here)
//   In8      : vcu  irq_enc
//   In9..12  : viz  DMAs            -- sentry/irq..irq3
//   In13,14  : mipi vc2,vc3 csirxss_csi_irq2,3   (b0030,b0032)
//   In17..20 : rd   DMAs             -- sentry/interrupt..interrupt3
//   In21     : finn rd DMA        (b000c)         -- sentry/irq4
//
// NOTE: vid_pre_proces hierarchy's external IRQ pins do NOT map
// straight vc0..3 -> {irq,irq1,irq2,irq3} / {interrupt..interrupt3}.
// The actual cross-bar wiring at the hier boundary (bd.tcl ~line 2086):
//   viz: vc0/irq -> irq    ; vc1/irq -> irq1
//        vc3/irq -> irq2   ; vc2/irq -> irq3
//   rd : vc0/interrupt -> interrupt    ; vc2/interrupt -> interrupt1
//        vc3/interrupt -> interrupt2   ; vc1/interrupt -> interrupt3
// Therefore the per-VC hwirq values below account for the swap.
// Symptom of leaving the naive mapping in place: vc2 + vc3 viz outputs
// stay black at runtime because their IRQs are routed to the wrong
// driver instance and frames never get serviced.

// Inf DMAs (b0000..b0003)  -- straight vc0..3 mapping (sentry/irq_fbwr_0..3)
&sentry_vid_pre_proces_vc0_axi4s_vid_dma_0 { interrupts = <0x2 0x4>; };
&sentry_vid_pre_proces_vc1_axi4s_vid_dma_0 { interrupts = <0x3 0x4>; };
&sentry_vid_pre_proces_vc2_axi4s_vid_dma_0 { interrupts = <0x4 0x4>; };
&sentry_vid_pre_proces_vc3_axi4s_vid_dma_0 { interrupts = <0x5 0x4>; };

// Viz DMAs (b0008..b000b) are now the axi4s_video_compress codec node,
// polled by the R52 -- no Linux IRQ override needed.

// RD DMAs (b0004..b0007)   -- vc1/vc2/vc3 ROTATED at hier boundary
&sentry_vid_pre_proces_vc0_axi4s_vid_dma_rd { interrupts = <0x11 0x4>; };
&sentry_vid_pre_proces_vc1_axi4s_vid_dma_rd { interrupts = <0x14 0x4>; };  // vc1/interrupt -> interrupt3 (In20)
&sentry_vid_pre_proces_vc2_axi4s_vid_dma_rd { interrupts = <0x12 0x4>; };  // vc2/interrupt -> interrupt1 (In18)
&sentry_vid_pre_proces_vc3_axi4s_vid_dma_rd { interrupts = <0x13 0x4>; };  // vc3/interrupt -> interrupt2 (In19)


// ================================================================
// ISP RPU calibration + mailbox reserved-memory (2026.1 SDT fix)
//
// The 2026.1 sdt_import no longer flattens
// versal-2ve-2vm-vek385-sdt-seg-system-conf.dtsi into the deployed
// cortexa78-linux.dts, so the labels the visp_ss_*/visp_mbox_rpu_6
// overrides above reference (rproc_D_0_6_calib_load,
// rproc_E_0_8_calib_load, isp_mbox_buffer) are no longer defined by
// the base DTS and dtc fails with "Reference to non-existent label".
//
// This block restores the FULL single-RPU6 ISP carveout that the
// 2025.2 SDT used to flatten in (rpu6 fw/calib/hal_mem_priv, isp_mbox,
// rpu_shared, isp_vring, tcm_rpu6) -- addresses verbatim from
// rave2-ecp.dtsi / system-conf.dtsi.  Without the fw/hal/shared/vring
// regions Linux+CMA could allocate into live ISP firmware DDR.
// RPU7/8/9 are unused (only IMX623 x4 on RPU6); rpu8_calib is the lone
// RPU8 leftover, kept only for the &visp_ss_01 override (see note below).
// Placed at the very end so the earlier /delete-node/ rpu*_calib_load
// statements (which target the retired RPU7/9 regions) don't remove them.
// All no-map; none overlap limo_buf@0x20000000 or CMA (0x28000000+).
// NOTE(boot): low-DDR reservations have a documented boot-hang history
// on this board (see the isp_slots note earlier) -- reverify the display
// path boots after adding these; if it hangs, the rpu6_fw@0x0C000000
// reservation is the first suspect.
// NOTE(hw): the matching remoteproc@ebb80000 r52f@0 loader (memory-region
// = <&rpu6_fw>) is now defined below so init_isp_4cam.sh can load
// isp-r52-6-firmware.elf into RPU6 (remoteproc1) -- reservations alone only
// protect DDR, they don't load firmware.
// ================================================================
/ {
	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		rpu6_fw: rproc6@0c000000 {
			no-map;
			reg = <0x0 0xC000000 0x0 0x3800000>;   /* 56 MB RPU6 ISP firmware */
		};
		rproc_D_0_6_calib_load: rpu6_calib_load {
			no-map;
			reg = <0x0 0xF800000 0x0 0x28000>;      /* 160 KB calibration */
		};
		rproc_D_0_6_hal_mem_priv: rpu6_hal_mem_priv {
			no-map;
			reg = <0x0 0xF828000 0x0 0x1001000>;    /* ~16 MB HAL private */
		};
		/*
		 * rpu8_calib_load: leftover from the AMD 2-ISP reference
		 * (RPU8 = ISP1); UNUSED on this single-ISP0 build.  Kept only
		 * because the &visp_ss_01 override still points its
		 * memory-region here.  Harmless (no-map, below limo_buf).
		 * Drop together with the visp_ss_01 override to fully retire RPU8.
		 */
		rproc_E_0_8_calib_load: rpu8_calib_load {
			no-map;
			reg = <0x0 0x18854000 0x0 0x28000>;
		};
		isp_mbox_buffer: isp_mbox_buffer@1E0A8000 {
			no-map;
			reg = <0x0 0x1E0A8000 0x0 0x400000>;    /* 4 MB RPU6<->A78 mailbox */
		};
		rpu_shared_mem: rpu_shared_mem@1E4A8000 {
			no-map;
			reg = <0x0 0x1E4A8000 0x0 0x40000>;     /* 256 KB RPU shared */
		};
		isp_vring: vring@1FFF7000 {
			no-map;
			reg = <0x0 0x1FFF7000 0x0 0x8000>;      /* 32 KB RPU6 vring */
		};
		tcm_rpu6: rpu6_tcm {
			no-map;
			reg = <0x0 0xEBB80000 0x0 0x30000>;     /* 192 KB RPU6 TCM */
		};
	};
};

// ----------------------------------------------------------------
// Reserve TTC4..TTC7 (timer@f1ea0000..f1ed0000) for the R52 ISP firmware.
//
// The isp-r52-N FreeRTOS firmware uses one of these TTCs as its scheduler
// tick (RPU6 -> ttc4 / 0xf1ea0000).  XTtcPs_CfgInitialize() bails with
// XST_DEVICE_IS_STARTED *without* setting IsReady if the TTC counter is
// already running; the subsequent XTtcPs_SetOptions() then trips
// Xil_AssertVoid(IsReady == XIL_COMPONENT_IS_READY) and the R52 spins
// forever in Xil_Assert -- it never gets past "=====TASKS CREATION DONE=====",
// so visp_mbox INIT_FIRMWARE times out (sync failed, -110).
//
// If Linux's cdns,ttc driver binds these nodes it starts their counters,
// causing exactly that.  The AMD reference (vek385-isp) leaves ttc4..ttc7
// disabled in Linux for this reason -- match it so the R52 owns them.
// ----------------------------------------------------------------
&ttc4 { status = "disabled"; };
&ttc5 { status = "disabled"; };
&ttc6 { status = "disabled"; };
&ttc7 { status = "disabled"; };

// (end of vek385-imx623-sentry.dtsi)

// ================================================================
// RPU-driven VCU2 codec: R52_1 controller + its working memory.
//
// Mirrors rave2-imx623-sentry. Everything the 32-bit R52 has to address is in
// low DDR; the coded access units are NOT -- the encoder DMAs those straight
// into codec_preroll in high DDR, which the R52 cannot reach and never needs to.
//
// The two fixed addresses come from the firmware (vcu2_encoder.c):
//   VCU2_SRC_EXTERN_BASE  0x28000000
//   VCU2_STREAM_HIGH_BASE 0x8_2C000000
// ================================================================
/ {
	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		/* TCM for R52_1 (r52_0b, RPU B0) so remoteproc reserves the ATCM+BTCM+CTCM window. */
		tcm_r52_1: r52_1_tcm@eba80000 {
			no-map;
			reg = <0x00 0xeba80000 0x00 0x30000>;  /* 192KB: ATCM+BTCM+CTCM */
		};

		/* DDR carveout for the R52_1 VCU-controller ELF (sentry-vcu-ctrl.elf).
		 * The Zephyr image links at 0x30000 with a ~2.9 MB footprint, so the
		 * carveout must cover 0x30000; 4 MB there. */
		r52_1_firmware: r52_1_fw@30000 {
			reg = <0x0 0x00030000 0x0 0x00400000>;  /* 4 MB */
			no-map;
		};

		/* 32 MB, not 8: ale2xx.fw links vaddr 0xC0000000..0xC2000000 and puts the
		 * H2M/M2H mailboxes near the top (+0x1FFB000), so a shorter window would
		 * put the mailbox rings inside the CMA carveout. */
		vcu2_fw: vcu2_fw@30000000 {
			reg = <0x0 0x30000000 0x0 0x02000000>;  /* 32 MB: FW image + H2M/M2H mailbox */
			no-map;
		};

		/* Overlaps the tail of vcu2_fw on purpose: the firmware allocator starts
		 * at 0x32000000, and drawing this node wider keeps 0x30000000..0x388900FF
		 * no-map in one piece. Two no-map nodes overlapping is harmless. */
		vcu2_cma: vcu2_cma@32000000 {
			reg = <0x0 0x32000000 0x0 0x06800000>;  /* 104 MB: CtrlSW CMA + bitstream out.
						 * Base/size MUST match VCU2_CMA_PHYS/VCU2_CMA_SIZE in
						 * r52-vcu-ctrl/examples/vcu2_app_example.c.  Starts where
						 * vcu2_fw ends (0x32000000) and ends exactly at
						 * vcu2_preroll_shared (0x38800000). */
			no-map;
		};

		/*
		 * Encoder controller <-> A78 structures (ERICA-E_rpu_vcu_sw include/):
		 *   0x38800000  VPRL pre-roll ring header, up to 8 channels  (vcu2_preroll.h)
		 *   0x38820000  submit ring 1, camera frames                 (vcu2_submit.h)
		 *   0x38830000  SDIR source directory, 8 channels x 7 slots
		 *   0x38840000  submit ring 2, frames the A78 composes
		 *   0x38848000  VCHM encoder channel map                     (vcu2_chmap.h)
		 *   0x3884A000  SGEN source-slot generations
		 *   0x38890000  controller debug words
		 * A controller restart clears 0x38820000..0x3889FFFF.
		 */
		vcu2_preroll_shared: vcu2_preroll_shared@38800000 {
			reg = <0x0 0x38800000 0x0 0x00100000>;  /* 1 MB: A78-visible pre-roll header */
			no-map;
		};

		/*
		 * NoC remap shadow -- this is NOT usable memory.
		 *
		 * bd.tcl sets CONFIG.REMAPS {M01_INI {{0x0_4000_0000 0x0_0200_0000_0000
		 * 0x10000000}}} on Master_NoC/M01_INI, the port that feeds ai_engine_0.
		 * Master_NoC/S08_AXI is ps_wizard_0/LPD_AXI_NOC0, so every LPD master -- gem1,
		 * USB, ADMA -- shares the R52s' remapped view: physical
		 * 0x40000000..0x4FFFFFFF reaches the AIE array, not DDR.
		 *
		 * Only the R52s are meant to use it.  They are exclude_bd_addr_seg'd from the
		 * AIE aperture at 0x200_0000_0000 (a 32-bit core cannot reach 2 TB), so this
		 * 256 MB alias is their only path to the array -- it is what the AIE manager
		 * firmware means by RPUFW_AIE2PS_BASE_ADDR=0x40000000.
		 *
		 * The A78 is NOT remapped and still sees real DRAM here.  That asymmetry is
		 * the hazard: a DMA buffer the kernel hands gem1 in this range is written by
		 * the CPU into DDR and fetched by the MAC out of the AIE.  The link comes up
		 * and passes no traffic.
		 *
		 * Verified by A/B on rave2-imx623 hardware 2026-08-31: booting a DTB with this
		 * node removed and cma=256M (so the default CMA lands on the window) gave no
		 * ping at all; restoring the node gave end0 up with 0 rx/tx errors.
		 *
		 * Consequences to keep in sync:
		 *   - `cma=` must fit a hole that is NOT this window (see chosen{} above).
		 *   - U-Boot fdt_addr_r must not point here, or lmb refuses every load and
		 *     the board dies with "Could not find a valid device tree".
		 *   - Must track the bd.tcl REMAPS window, base AND size.
		 */
		aie_remap_shadow: aie_remap_shadow@40000000 {
			reg = <0x0 0x40000000 0x0 0x10000000>;  /* 256 MB */
			no-map;
		};

		/* ISP chain-6 (second output chain) buffer pool.
		 *
		 * Under RPU-master the R52 replays a recorded APU-master bring-up
		 * command stream (isp_cmds-vek385.bin).  SETUP_BUFFER_POOL (cmd 33)
		 * is issued twice per camera.  Chain 0 carries the correct, reserved
		 * limo_buf bases (0x28000000 + ch*0x2000000).  Chain 6 carries the
		 * *Linux CMA* addresses that were live when the stream was recorded:
		 *
		 *   inst 0  4 x 0x438000  0x62200000-0x63537FFF
		 *   inst 1  4 x 0x438000  0x63600000-0x64937FFF
		 *   inst 2  4 x 0x438000  0x64A00000-0x65D37FFF
		 *   inst 3  4 x 0x438000  0x65E00000-0x67137FFF
		 *
		 * aie_remap_shadow above pushes this board's `cma=256M` arena to
		 * 0x60000000, so those addresses land inside it and the ISP writes
		 * NV12 frames straight over whatever Linux has allocated -- including
		 * DRM dumb framebuffers.  Seen as a rolling gray/white speckle over
		 * the display: ~90% of a freshly written framebuffer overwritten
		 * within 5 s of replay, in units of exactly one NV12 1920x1536 frame
		 * (0x438000).  Reserving the range keeps Linux out of it; confirmed
		 * on hardware 2026-09-08, the speckle disappears.
		 *
		 * NOTE: tied to the addresses baked into the current recording.  If
		 * isp_cmds-vek385.bin is re-recorded, re-derive this range (parse
		 * cmd 33 for chainId 6) or switch to a firmware-side retarget in
		 * R52/src/isp_replay.c.
		 *
		 * rave2-imx623 has the same defect but must NOT get a carveout: its
		 * recorded chain-6 range is 0x40200000-0x45137FFF, which is inside
		 * aie_remap_shadow there (that recording predates the carveout, when
		 * rave2's CMA still sat at 0x40000000).  That board needs its stream
		 * re-recorded instead -- see scripts/capture_isp_cmds.sh.
		 */
		isp_chain6_pool: isp_chain6@62200000 {
			reg = <0x0 0x62200000 0x0 0x5000000>;   /* 80 MB, ends 0x671FFFFF */
			no-map;
		};


		/* A78 <-> R52 AIE-manager shared-memory rings (no-map: the R52 and
		 * the A78 client map it directly; keep Linux allocators out).
		 * 2 clients x 0x18000: apu0_client @0xBBE00000, apu1_client @0xBBE18000
		 * (shmem_clients_cfg[] in the FW's shmem_platform.c). Each client is
		 * 3 x 32 KB: mgmt-rx, mgmt-tx, doorbell. OCM bank 2 is 0xBBE00000. */
		rpu_aie_shmem: rpu_aie_shmem@bbe00000 {
			no-map;
			reg = <0x0 0xBBE00000 0x0 0x30000>;     /* 192 KB (2 clients) */
		};

		/* AIE-manager firmware window for R52_0 (remoteproc@eba00000).
		 *
		 * The stock telluride rpu_fw links at 0x30000, which collides with
		 * r52_1_fw@30000 (sentry-vcu-ctrl.elf on R52_1) since both cores run
		 * concurrently. Our build relinks the image to 0x800000 via
		 * rpu_fw_sentry/sentry.overlay (&ddr_firmware) and keeps the
		 * reference's stock addresses for everything else, so this one window
		 * covers the lot:
		 *   0x430000  256 KB  dram_log_buf
		 *   0x470000  256 B   rsctbl        <- ELF LOAD segment
		 *   0x478000  288 KB  rpmsg_shmem   (unused, CONFIG_OPENAMP=n)
		 *   0x4C0000  3 MB    host_gem_carveout
		 *   0x800000  4 MB    firmware image <- ELF LOAD segments
		 */
		aie_mgr_fw: aie_mgr_fw@430000 {
			no-map;
			reg = <0x0 0x00430000 0x0 0x007D0000>;  /* 7.8 MB, ends 0x00C00000 */
		};

	};

	/* R52_1 is RPU cluster B core 0 (MPIDR 0x100, SMID 0x202); the core and
	 * its TCMs must belong to the same RPU.  The PLM powers up and releases
	 * the reset of whichever core owns a requested TCM bank, so requesting
	 * TCM_A_1x here brings RPU A core 1 up running from an empty TCM: it
	 * slides into this firmware at 0x30000 and writes over R52_1's stacks
	 * with SMID 0x201.  The firmware does not use its TCMs; the driver
	 * requires at least one bank per core. */
	remoteproc@eba80000 {
		compatible = "xlnx,versal-net-r52fss";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		xlnx,cluster-mode = <0x00>;
		ranges = <0x00 0x00 0x00 0xeba80000 0x00 0x10000
			  0x00 0x10000 0x00 0xeba90000 0x00 0x8000
			  0x00 0x18000 0x00 0xebaa0000 0x00 0x8000>;

		r52f@0 {
			compatible = "xlnx,versal2-r52f";
			power-domains = <&versal2_firmware 0x181100c1>,	/* PM_DEV_RPU_B_0 */
					<&versal2_firmware 0x183180d1>,	/* PM_DEV_TCM_B_0A */
					<&versal2_firmware 0x183180d2>,	/* PM_DEV_TCM_B_0B */
					<&versal2_firmware 0x183180d3>;	/* PM_DEV_TCM_B_0C */
			reg = <0x00 0x00 0x00 0x10000
			       0x00 0x10000 0x00 0x8000
			       0x00 0x18000 0x00 0x8000>;
			reg-names = "r52_0b_atcm_global@eba80000",
				    "r52_0b_btcm_global@eba90000",
				    "r52_0b_ctcm_global@ebaa0000";
			memory-region = <&r52_1_firmware>, <&r52_firmware>;  /* + the 0x50000000 window: sentry_r52_*.elf links there, sentry-vcu-ctrl.elf at 0x30000 */
		};
	};
};
