&sentry_vid_pre_proces_vc3_axis_broadcaster_0 {
	compatible = "xlnx,axis-broadcaster-1.1";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			bcast3_in_ep: endpoint {
				remote-endpoint = <&frmbuf3_out_ep>;
			};
		};
		port@1 {
			reg = <1>;
			bcast3_inf_out_ep: endpoint {
				remote-endpoint = <&inf3_in_ep>;
			};
		};
		port@2 {
			reg = <2>;
			bcast3_viz_out_ep: endpoint {
				remote-endpoint = <&viz3_in_ep>;
			};
		};
	};
};
