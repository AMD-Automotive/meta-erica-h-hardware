--- a/lopper/assists/bmcmake_metadata_xlnx.py
+++ b/lopper/assists/bmcmake_metadata_xlnx.py
@@ -387,11 +387,30 @@ def xlnx_generate_cmake_metadata(tgt_node, sdt, options):
     node_list = []
     chosen_node = ""
     symbol_node = ""
+    # ERICA fix: prefer the "chosen" node belonging to the domain actually
+    # being processed (matched via the CPU cluster phandle), instead of
+    # blindly taking whichever "chosen"-named node is encountered LAST while
+    # recursively traversing the whole tree from tgt_node ("/"). Sibling
+    # domains under /domains can each carry their own chosen block (e.g.
+    # RPU_4_BM: serial1, PMC_MB: serial0) -- without this, STDIN_INSTANCE
+    # silently picks up whichever domain's chosen happens to appear last in
+    # tree order, independent of which domain/CPU is actually being built.
+    cluster_phandle = None
+    try:
+        cluster_phandle = getattr(bm_config.get_cpu_node(sdt, options).parent, "phandle", None)
+    except Exception:
+        pass
+    domain_chosen_node = ""
     # Traverse the tree and find the nodes having status=ok property
     for node in root_sub_nodes:
         try:
             if node.name == "chosen":
-                chosen_node = node
+                if chosen_node == "":
+                    chosen_node = node
+                if cluster_phandle is not None:
+                    parent_cpus = node.parent.propval("cpus")
+                    if parent_cpus and parent_cpus != [''] and parent_cpus[0] == cluster_phandle:
+                        domain_chosen_node = node
             if node.name == "__symbols__":
                 symbol_node = node
             status = node["status"].value
@@ -399,6 +418,8 @@ def xlnx_generate_cmake_metadata(tgt_node, sdt, options):
                 node_list.append(node)
         except:
            pass
+    if domain_chosen_node:
+        chosen_node = domain_chosen_node
 
     src_path = options['args'][1]
     command = options['args'][2]
